<?php

/**
 * Ensures the TX data source is enabled after updating from the old module.
 */
function nass_tools_update_11001(): void {
  $config = \Drupal::configFactory()->getEditable('nass_release.adminsettings');
  if (!is_array($config->get('release_sources'))) {
    $config->set('release_sources', [
      'tx' => TRUE,
      'api' => FALSE,
      'node' => TRUE,
    ]);
  }
  if (!is_array($config->get('source_priority'))) {
    $config->set('source_priority', ['tx', 'api', 'node']);
  }
  if ($config->get('tx_use_module_data_fallback') === NULL) {
    $config->set('tx_use_module_data_fallback', TRUE);
  }
  if ($config->get('tx_use_snapshot_cache') === NULL) {
    $config->set('tx_use_snapshot_cache', TRUE);
  }
  if (!$config->get('timezone')) {
    $config->set('timezone', 'America/New_York');
  }
  if (!$config->get('upcoming_days')) {
    $config->set('upcoming_days', 7);
  }
  $config->save(TRUE);
  \Drupal::service('nass_release.tx_snapshot_manager')->scan(TRUE);
}

/**
 * Places the Today's Releases block back on the homepage.
 */
function nass_tools_update_11002(): void {
  $theme = \Drupal::config('system.theme')->get('default') ?: 'nass';
  $block_id = $theme . '_nassreleasetodaysrelease';
  $config = \Drupal::configFactory()->getEditable('block.block.' . $block_id);

  // If the block config does not exist under the active theme name, fall back to
  // the legacy NASS block machine name used by the migrated database.
  if ($config->isNew()) {
    $block_id = 'nass_nassreleasetodaysrelease';
    $config = \Drupal::configFactory()->getEditable('block.block.' . $block_id);
  }

  if ($config->isNew()) {
    $config->setData([
      'uuid' => \Drupal::service('uuid')->generate(),
      'langcode' => 'en',
      'status' => TRUE,
      'dependencies' => [
        'module' => ['nass_tools'],
        'theme' => [$theme],
      ],
      'id' => $block_id,
      'theme' => $theme,
      'region' => 'content',
      'weight' => -50,
      'provider' => NULL,
      'plugin' => 'nass_release_todays_release',
      'settings' => [
        'id' => 'nass_release_todays_release',
        'label' => "NASS Release - Today's Release",
        'label_display' => '0',
        'provider' => 'nass_tools',
      ],
      'visibility' => [
        'request_path' => [
          'id' => 'request_path',
          'negate' => FALSE,
          'pages' => '<front>',
        ],
      ],
    ]);
  }
  else {
    $data = $config->getRawData();
    $data['status'] = TRUE;
    $data['theme'] = $data['theme'] ?? $theme;
    $data['region'] = 'content';
    $data['weight'] = -50;
    $data['plugin'] = 'nass_release_todays_release';
    $data['settings']['id'] = 'nass_release_todays_release';
    $data['settings']['label'] = $data['settings']['label'] ?? "NASS Release - Today's Release";
    $data['settings']['label_display'] = '0';
    $data['settings']['provider'] = 'nass_tools';
    $data['visibility']['request_path'] = [
      'id' => 'request_path',
      'negate' => FALSE,
      'pages' => '<front>',
    ];
    $config->setData($data);
  }

  $config->save(TRUE);
  \Drupal::service('plugin.manager.block')->clearCachedDefinitions();
}


/**
 * Reassigns legacy block configuration dependencies/providers to nass_tools.
 *
 * This does not change plugin IDs. It only prevents placed blocks from keeping
 * stale dependencies on the old split modules after the consolidated module is
 * enabled.
 */
function nass_tools_update_11003(): void {
  $legacy_modules = [
    'nass_maps',
    'nass_market_value',
    'nass_quick_stats',
    'nass_regional_office',
    'nass_release',
    'nass_watershed',
  ];
  $plugin_ids = [
    'nass_us_map',
    'nass_market_value_map',
    'nass_quick_stats',
    'nass_regional_office_map',
    'nass_release_whats_new',
    'nass_release_state_select',
    'nass_release_todays_release',
    'nass_release_year_list',
    'nass_watershed',
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('block');
  foreach ($storage->loadMultiple() as $block) {
    if (!in_array($block->getPluginId(), $plugin_ids, TRUE)) {
      continue;
    }
    $changed = FALSE;
    $dependencies = $block->getDependencies();
    if (!empty($dependencies['module'])) {
      $dependencies['module'] = array_values(array_unique(array_diff($dependencies['module'], $legacy_modules)));
      if (!in_array('nass_tools', $dependencies['module'], TRUE)) {
        $dependencies['module'][] = 'nass_tools';
      }
      $block->set('dependencies', $dependencies);
      $changed = TRUE;
    }
    $settings = $block->get('settings') ?: [];
    if (!empty($settings['provider']) && in_array($settings['provider'], $legacy_modules, TRUE)) {
      $settings['provider'] = 'nass_tools';
      $block->set('settings', $settings);
      $changed = TRUE;
    }
    if ($changed) {
      $block->save();
    }
  }
  \Drupal::service('plugin.manager.block')->clearCachedDefinitions();
}
