<div class="nass-release-calendar-page">
  <div class="nass-release-calendar-controls">
    <h2>{{ month_label }}</h2>
    <p>
      <a class="usa-button usa-button--outline" href="{{ previous_month_url }}">Previous</a>
      <a class="usa-button usa-button--outline" href="{{ next_month_url }}">Next</a>
    </p>
  </div>

  <table class="nass-release-calendar-table">
    <thead>
      <tr>
        <th>Monday</th>
        <th>Tuesday</th>
        <th>Wednesday</th>
        <th>Thursday</th>
        <th>Friday</th>
      </tr>
    </thead>
    <tbody>
      {% for week in calendar_days|batch(5) %}
        <tr>
          {% for day in week %}
            <td class="{% if not day.in_month %}is-outside-month{% endif %}">
              <strong>{{ day.day }}</strong>
              {% if events_by_date[day.date] is defined %}
                <ul>
                  {% for record in events_by_date[day.date] %}
                    <li>
                      <span>{{ record.release_datetime|date('g:i a') }} ET</span><br>
                      {% if record.url %}
                        <a href="{{ record.url }}">{{ record.title }}</a>
                      {% else %}
                        {{ record.title }}
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </td>
          {% endfor %}
        </tr>
      {% endfor %}
    </tbody>
  </table>

  {% if events_by_date is empty %}
    <p>There are no NASS reports scheduled for this month.</p>
  {% endif %}
</div>
