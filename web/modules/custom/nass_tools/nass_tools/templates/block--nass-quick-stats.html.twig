{{ attach_library('nass_tools/nass_quick_stats') }}
<div id="quickstats">
  <div class="grid-row grid-gap-lg">
    {% if nass_quick_stats_disable == 1 %}
      <div class="grid-col-12">
        <div class="usa-alert usa-alert--warning">
          <div class="usa-alert__body">
            <p class="usa-alert__text">
              {{nass_quick_stats_disabled_msg}}
            </p>
          </div>
        </div>
      </div>
    {% endif %}
    <div class="grid-col-12">
    {{nass_quick_stats_textarea|t}}
    </div>
    {% if nass_quick_stats_disable == 0 %}
      <div class="grid-col-12 tablet:grid-col-3">
        <img id="sector-ajaxLoader" src="{{ nqs_image_path }}/throbber.gif"/>
        <div id="sector-wrap" style="opacity:0;">
          <label class="usa-label" for="sector">Sector</label>
          <select class="usa-select" name="sector" id="sector">
            <option value>Select a sector</option>
          </select>
        </div>
      </div>
      <div class="grid-col-12 tablet:grid-col-3">
        <img id="group-ajaxLoader" src="{{ nqs_image_path }}/throbber.gif"/>
        <div id="group-wrap" style="opacity:0;">
          <label class="usa-label" for="group">Group</label>
          <select class="usa-select" name="group" id="group">
            <option value>Select a group</option>
          </select>
        </div>
      </div>
      <div class="grid-col-12 tablet:grid-col-3">
        <img id="commodity-ajaxLoader" src="{{ nqs_image_path }}/throbber.gif"/>
        <div id="commodity-wrap" style="opacity:0;">
          <label class="usa-label" for="commodity">Commodity</label>
          <select class="usa-select" name="commodity" id="commodity">
            <option value>Select a commodity</option>
          </select>
        </div>
      </div>
    {% endif %}
  </div>
  {% if nass_quick_stats_disable == 0 %}
    <div class="grid-row grid-gap-lg">
      <div class="grid-col-12 tablet:grid-col-12" id="quickstats-list-query">
        <ul id="quickstat-checkboxes"></ul>
        <button type="" class="usa-button" id="quickstats-results" disabled="disabled">Get Results</button>
      </div>
    </div>
  {% endif %}
</div>

<div id="results-table">
  <div class="grid-row grid-gap-lg">
    <div class="usa-table-container--scrollable" tabindex="0">
      <img id="ajaxLoader" src="{{ nqs_image_path }}/throbber.gif"/>
      <table class="usa-table usa-table--compact usa-table--striped">
        <thead>
          <tr>
          </tr>
        </thead>
        <tbody>
        </tbody>
      </table>
    </div>
  </div>
</div>