<div class="nass-release-calendar">
  <div class="nass-release-calendar__toolbar">
    <h2>{{ month_label }}</h2>
    <div class="nass-release-calendar__nav">
      <a class="usa-button usa-button--outline" href="?month={{ prev_month }}">←</a>
      <a class="usa-button usa-button--outline" href="?month={{ next_month }}">→</a>
    </div>
  </div>

  <table class="nass-release-calendar__table">
    <thead>
      <tr>
        <th>Monday</th><th>Tuesday</th><th>Wednesday</th><th>Thursday</th><th>Friday</th>
      </tr>
    </thead>
    <tbody>
      {% for week in weeks %}
        <tr>
          {% for day in week %}
            <td class="{% if not day.in_month %}is-outside-month{% endif %}">
              <div class="nass-release-calendar__day">{{ day.day }}</div>
              {% for item in day.items %}
                <div class="nass-release-calendar__item">
                  <span>{{ item.time }}</span>
                  {% if item.url %}<a href="{{ item.url }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}
                </div>
              {% endfor %}
            </td>
          {% endfor %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
