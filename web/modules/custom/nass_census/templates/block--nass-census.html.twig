<div class="">
{% set url = url('<current>')|render|render %}
{% set state = url|split('/')|last %}
{% set state = state|raw %}

{% if elements['#configuration'].label %}
  <h3>{{ elements['#configuration'].label }}</h3>
{% endif %}
<h4>State and County Reports</h4>
<ul>
<li><a href="/data-and-statistics/state/{{state|replace({' ': '-'})}}/census">State</a></li>
<li><a href="/data-and-statistics/county/{{state|replace({' ': '-'})}}/census">County</a></li>
</ul>
<h4>Profiles</h4>
<ul>
<li>State & County</li>
<li>Race, Ethnicity and Gender</li>
</ul>
<h4>Rankings</h4>
<ul>
<li><a href="/data-and-statistics/census/ranking-of-market-value/{{state|replace({' ': '-'})}}" target="_blank">State & County</a></li>
</ul>
<h4>Congressional Districts</h4>
<ul>
<li>Congressional District Rankings</li>
<li>Congressional District Profiles</li>
</ul>
<h4>Census Quick Stats</h4>
<ul>
<li>State & County</li>
<li>Race, Ethnicity and Gender</li>
</ul>
</div>
