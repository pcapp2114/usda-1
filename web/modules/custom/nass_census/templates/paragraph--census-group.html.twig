<section class="nass-census-group">
  {% if content.census_group_title %}
    <h3 class="nass-census-group__title">{{ content.census_group_title }}</h3>
  {% endif %}
  {% if content.census_group_description %}
    <div class="nass-census-group__description">{{ content.census_group_description }}</div>
  {% endif %}
  {% if content.census_group_items %}
    <div class="nass-census-group__items">{{ content.census_group_items }}</div>
  {% endif %}
</section>
