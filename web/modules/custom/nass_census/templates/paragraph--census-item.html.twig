<article class="nass-census-item">
  <div class="nass-census-item__body">
    {% if content.census_item_title %}
      <h3 class="nass-census-item__title">{{ content.census_item_title }}</h3>
    {% endif %}

    {% if content.census_item_summary %}
      <div class="nass-census-item__summary">{{ content.census_item_summary }}</div>
    {% endif %}

    {% if content.census_item_description %}
      <div class="nass-census-item__description">{{ content.census_item_description }}</div>
    {% endif %}

    {% if content.census_item_actions %}
      <div class="nass-census-item__actions" aria-label="Available links and downloads">
        {{ content.census_item_actions }}
      </div>
    {% endif %}

    {% if content.census_item_groups %}
      <div class="nass-census-item__groups">{{ content.census_item_groups }}</div>
    {% endif %}
  </div>

  {% if content.census_item_release_date %}
    <div class="nass-census-item__date">
      <span class="nass-census-item__date-label">Release Date</span>
      <span class="nass-census-item__date-value">{{ content.census_item_release_date }}</span>
    </div>
  {% endif %}
</article>
