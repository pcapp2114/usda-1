{% set layout = paragraph.census_section_layout.value ?: 'standard' %}
<section id="{{ nass_census_section_id }}" class="nass-census-section nass-census-section--{{ layout|clean_class }}">
  <div class="nass-census-section__header">
    {% if content.census_section_title %}
      <h2 class="nass-census-section__title">{{ content.census_section_title }}</h2>
    {% endif %}
    {% if content.census_section_intro %}
      <div class="nass-census-section__intro">{{ content.census_section_intro }}</div>
    {% endif %}
  </div>

  {% if content.census_section_media %}
    <div class="nass-census-section__media">{{ content.census_section_media }}</div>
  {% endif %}

  {% if content.census_section_groups %}
    <div class="nass-census-section__groups">{{ content.census_section_groups }}</div>
  {% endif %}

  {% if content.census_section_items %}
    <div class="nass-census-section__items">{{ content.census_section_items }}</div>
  {% endif %}

  {% if content.census_section_publications %}
    <div class="nass-census-section__publications">{{ content.census_section_publications }}</div>
  {% endif %}
</section>
