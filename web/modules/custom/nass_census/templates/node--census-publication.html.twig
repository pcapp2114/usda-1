{#
/**
 * @file
 * NASS Census publication detail template.
 *
 * Place in: web/modules/custom/nass_census/templates/node--census-publication.html.twig
 */
#}
{% set description = content.census_description|render %}
{% set primary_media = content.census_primary_media|render %}
{% set sections = content.census_sections|render %}
{% set related_publications = content.census_related_publications|render %}
{% set source_url = content.census_source_url|render %}

<article{{ attributes.addClass('nass-census-publication-page') }}>
  <header class="nass-census-publication-page__hero">
    <div class="nass-census-page__eyebrow">Census Publication</div>
    <h1{{ title_attributes.addClass('nass-census-publication-page__title') }}>{{ label }}</h1>

    <dl class="nass-census-meta">
      {% if node.census_year.value %}
        <div class="nass-census-meta__item">
          <dt>Year</dt>
          <dd>{{ node.census_year.value }}</dd>
        </div>
      {% endif %}
      {% if node.census_publication_kind.value %}
        <div class="nass-census-meta__item">
          <dt>Type</dt>
          <dd>{{ node.census_publication_kind.value|replace({'_': ' '})|title }}</dd>
        </div>
      {% endif %}
      {% if node.census_within.value %}
        <div class="nass-census-meta__item">
          <dt>Within</dt>
          <dd>{{ node.census_within.value|replace({'_': ' '})|title }}</dd>
        </div>
      {% endif %}
    </dl>

    {% if description|striptags|trim %}
      <div class="nass-census-publication-page__description">
        {{ description }}
      </div>
    {% endif %}

    {% if primary_media|striptags|trim %}
      <div class="nass-census-publication-page__primary-media">
        {{ primary_media }}
      </div>
    {% endif %}
  </header>

  {% if sections|striptags|trim %}
    <div class="nass-census-publication-page__sections">
      {{ sections }}
    </div>
  {% endif %}

  {% if related_publications|striptags|trim %}
    <section class="nass-census-related" aria-labelledby="nass-census-publication-related-title">
      <h2 id="nass-census-publication-related-title" class="nass-census-related__title">Related Publications</h2>
      {{ related_publications }}
    </section>
  {% endif %}

  {% if source_url|striptags|trim %}
    <footer class="nass-census-page__source">
      <span class="nass-census-page__source-label">Original source:</span>
      {{ source_url }}
    </footer>
  {% endif %}
</article>
