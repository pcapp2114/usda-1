<?php

/**
 * @file
 * Theme helpers for the NASS Census content model.
 */

use Drupal\Component\Utility\Html;
use Drupal\file\FileInterface;
use Drupal\media\MediaInterface;
use Drupal\paragraphs\ParagraphInterface;

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_theme().
 */
function nass_census_theme($existing, $type, $theme, $path) {
  return [
    'block__nass_census' => [],
  ];
}

/**
 * Implements hook_theme_suggestions_paragraph_alter().
 */
function nass_census_theme_suggestions_paragraph_alter(array &$suggestions, array $variables): void {
  if (!empty($variables['elements']['#paragraph']) && $variables['elements']['#paragraph'] instanceof ParagraphInterface) {
    $paragraph = $variables['elements']['#paragraph'];
    $suggestions[] = 'paragraph__' . $paragraph->bundle();
  }
}

/**
 * Implements hook_preprocess_node().
 */
function nass_census_preprocess_node(array &$variables): void {
  if (empty($variables['node']) || !in_array($variables['node']->bundle(), ['census', 'census_publication'], TRUE)) {
    return;
  }

  $node = $variables['node'];
  $variables['#attached']['library'][] = 'nass_census/census_display';
  $variables['nass_census_nav'] = [];

  if ($node->bundle() === 'census' && $node->hasField('census_sections') && !$node->get('census_sections')->isEmpty()) {
    foreach ($node->get('census_sections') as $item) {
      $section = $item->entity;
      if (!$section instanceof ParagraphInterface) {
        continue;
      }

      $title = '';
      if ($section->hasField('census_section_title') && !$section->get('census_section_title')->isEmpty()) {
        $title = (string) $section->get('census_section_title')->value;
      }

      if ($title === '') {
        continue;
      }

      $key = '';
      if ($section->hasField('census_section_key') && !$section->get('census_section_key')->isEmpty()) {
        $key = (string) $section->get('census_section_key')->value;
      }

      $variables['nass_census_nav'][] = [
        'title' => $title,
        'id' => nass_census_section_dom_id($section, $key ?: $title),
      ];
    }
  }
}


/**
 * Builds a stable DOM ID for a Census section paragraph.
 */
function nass_census_section_dom_id(ParagraphInterface $paragraph, string $fallback): string {
  $base = trim($fallback) !== '' ? $fallback : 'section-' . $paragraph->id();
  return 'census-' . Html::getId($base);
}

/**
 * Implements hook_preprocess_paragraph().
 */
function nass_census_preprocess_paragraph(array &$variables): void {
  if (empty($variables['paragraph']) || !$variables['paragraph'] instanceof ParagraphInterface) {
    return;
  }

  $paragraph = $variables['paragraph'];
  if (in_array($paragraph->bundle(), ['census_section', 'census_group', 'census_item', 'census_action'], TRUE)) {
    $variables['#attached']['library'][] = 'nass_census/census_display';
  }

  if ($paragraph->bundle() === 'census_section') {
    $key = '';
    if ($paragraph->hasField('census_section_key') && !$paragraph->get('census_section_key')->isEmpty()) {
      $key = (string) $paragraph->get('census_section_key')->value;
    }
    $title = '';
    if ($paragraph->hasField('census_section_title') && !$paragraph->get('census_section_title')->isEmpty()) {
      $title = (string) $paragraph->get('census_section_title')->value;
    }
    $variables['nass_census_section_id'] = nass_census_section_dom_id($paragraph, $key ?: $title);
  }

  if ($paragraph->bundle() !== 'census_action') {
    return;
  }

  $variables['nass_action'] = [
    'kind' => NULL,
    'url' => NULL,
    'title' => NULL,
    'mime' => NULL,
    'extension' => NULL,
    'icon' => 'file',
    'is_external' => FALSE,
  ];

  // File wins over link when both are filled.
  if ($paragraph->hasField('census_action_file') && !$paragraph->get('census_action_file')->isEmpty()) {
    $media = $paragraph->get('census_action_file')->entity;
    if ($media instanceof MediaInterface) {
      $file = nass_census_media_file($media);
      if ($file instanceof FileInterface) {
        $mime = $file->getMimeType();
        $extension = strtolower(pathinfo($file->getFilename(), PATHINFO_EXTENSION));
        $variables['nass_action'] = [
          'kind' => 'file',
          'url' => $file->createFileUrl(FALSE),
          'title' => $media->label() ?: $file->getFilename(),
          'mime' => $mime,
          'extension' => $extension,
          'icon' => nass_census_file_icon($mime, $extension),
          'is_external' => FALSE,
        ];
        return;
      }

      $variables['nass_action'] = [
        'kind' => 'media',
        'url' => $media->toUrl()->toString(),
        'title' => $media->label(),
        'mime' => NULL,
        'extension' => NULL,
        'icon' => 'file',
        'is_external' => FALSE,
      ];
      return;
    }
  }

  if ($paragraph->hasField('census_action_link') && !$paragraph->get('census_action_link')->isEmpty()) {
    $item = $paragraph->get('census_action_link')->first();
    try {
      $url = $item->getUrl();
      $variables['nass_action'] = [
        'kind' => 'link',
        'url' => $url->toString(),
        'title' => $item->title ?: $item->uri,
        'mime' => NULL,
        'extension' => NULL,
        'icon' => $url->isExternal() ? 'external' : 'link',
        'is_external' => $url->isExternal(),
      ];
    }
    catch (\Exception $e) {
      // Invalid links should not break rendering.
    }
  }
}

/**
 * Returns the source file for a media entity when possible.
 */
function nass_census_media_file(MediaInterface $media): ?FileInterface {
  $source = $media->getSource();
  $source_field = $source->getConfiguration()['source_field'] ?? NULL;

  if ($source_field && $media->hasField($source_field) && !$media->get($source_field)->isEmpty()) {
    $entity = $media->get($source_field)->entity;
    return $entity instanceof FileInterface ? $entity : NULL;
  }

  foreach (['field_media_file', 'field_document', 'field_file'] as $field_name) {
    if ($media->hasField($field_name) && !$media->get($field_name)->isEmpty()) {
      $entity = $media->get($field_name)->entity;
      return $entity instanceof FileInterface ? $entity : NULL;
    }
  }

  return NULL;
}

/**
 * Maps MIME type / extension to a display icon class.
 */
function nass_census_file_icon(?string $mime, ?string $extension): string {
  $extension = strtolower((string) $extension);
  if ($extension === 'pdf' || $mime === 'application/pdf') {
    return 'pdf';
  }
  if (in_array($extension, ['xls', 'xlsx', 'csv'], TRUE) || str_contains((string) $mime, 'spreadsheet') || str_contains((string) $mime, 'csv')) {
    return 'spreadsheet';
  }
  if (in_array($extension, ['doc', 'docx'], TRUE) || str_contains((string) $mime, 'word')) {
    return 'document';
  }
  if ($extension === 'zip' || str_contains((string) $mime, 'zip')) {
    return 'archive';
  }
  return 'file';
}
