<?php

/**
 * @file
 * Install/uninstall hooks for the NASS Census content model.
 */

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;
use Drupal\paragraphs\Entity\ParagraphsType;
use Drupal\taxonomy\Entity\Term;


/**
 * Implements hook_install().
 */
function nass_census_install(): void {
  nass_census_v13_ensure_census_year_term();
  nass_census_v13_ensure_census_year_required();
  nass_census_v13_repair_node_form_displays_and_groups();
  nass_census_v14_repair_field_group_display_metadata();
  nass_census_agcensus_create_content_model();
}

/**
 * Implements hook_uninstall().
 *
 * This module is still being iterated, so uninstall intentionally removes the
 * config it owns. Do not use this on a site where NASS Census content should be
 * preserved.
 */
function nass_census_uninstall(): void {
  nass_census_delete_owned_content();
  nass_census_delete_owned_config();
}

/**
 * Deletes content entities that use the bundles created by this module.
 */
function nass_census_delete_owned_content(): void {
  $entity_type_manager = \Drupal::entityTypeManager();

  // Delete nodes first so paragraph references are released.
  if (\Drupal::moduleHandler()->moduleExists('node')) {
    $node_storage = $entity_type_manager->getStorage('node');
    $nids = $node_storage->getQuery()
      ->condition('type', ['census', 'census_publication', 'ag_census_page'], 'IN')
      ->accessCheck(FALSE)
      ->execute();
    if ($nids) {
      $node_storage->delete($node_storage->loadMultiple($nids));
    }
  }

  // Delete owned paragraphs.
  if (\Drupal::moduleHandler()->moduleExists('paragraphs') && $entity_type_manager->hasDefinition('paragraph')) {
    $paragraph_storage = $entity_type_manager->getStorage('paragraph');
    $pids = $paragraph_storage->getQuery()
      ->condition('type', ['census_section', 'census_group', 'census_item', 'census_action', 'agc_section', 'agc_resource_item', 'agc_action_link'], 'IN')
      ->accessCheck(FALSE)
      ->execute();
    if ($pids) {
      $paragraph_storage->delete($paragraph_storage->loadMultiple($pids));
    }
  }
}

/**
 * Deletes configuration owned by this module in a safe order.
 */
function nass_census_delete_owned_config(): void {
  $config_factory = \Drupal::configFactory();

  $prefixes = [
    'field.group.node.census.',
    'field.group.node.census_publication.',
    'field.group.paragraph.census_section.',
    'field.group.paragraph.census_group.',
    'field.group.paragraph.census_item.',
    'field.group.paragraph.census_action.',
    'core.entity_form_display.node.census',
    'core.entity_form_display.node.census_publication',
    'core.entity_form_display.paragraph.census_section',
    'core.entity_form_display.paragraph.census_group',
    'core.entity_form_display.paragraph.census_item',
    'core.entity_form_display.paragraph.census_action',
    'core.entity_view_display.node.census',
    'core.entity_view_display.node.census_publication',
    'core.entity_view_display.paragraph.census_section',
    'core.entity_view_display.paragraph.census_group',
    'core.entity_view_display.paragraph.census_item',
    'core.entity_view_display.paragraph.census_action',
    'field.field.node.census.',
    'field.field.node.census_publication.',
    'field.field.paragraph.census_section.',
    'field.field.paragraph.census_group.',
    'field.field.paragraph.census_item.',
    'field.field.paragraph.census_action.',
    'field.storage.node.census_',
    'field.storage.paragraph.census_',
    'node.type.census',
    'node.type.census_publication',
    'paragraphs.paragraphs_type.census_section',
    'paragraphs.paragraphs_type.census_group',
    'paragraphs.paragraphs_type.census_item',
    'paragraphs.paragraphs_type.census_action',
    'node.type.ag_census_page',
    'paragraphs.paragraphs_type.agc_section',
    'paragraphs.paragraphs_type.agc_resource_item',
    'paragraphs.paragraphs_type.agc_action_link',
  ];

  foreach ($prefixes as $prefix) {
    foreach ($config_factory->listAll($prefix) as $name) {
      $config_factory->getEditable($name)->delete();
    }
  }

  // Also remove matching field config/storage through config entities when they
  // are still loadable. This helps clear deleted-field state during iterations.
  foreach (FieldConfig::loadMultiple() as $field_config) {
    $name = $field_config->getName();
    $target_type = $field_config->getTargetEntityTypeId();
    $bundle = $field_config->getTargetBundle();
    $is_census_field = str_starts_with($name, 'census_');
    $is_agcensus_field = in_array($name, nass_census_agcensus_field_names(), TRUE);
    if (($is_census_field || $is_agcensus_field) && in_array($target_type, ['node', 'paragraph'], TRUE) && in_array($bundle, [
      'census',
      'census_publication',
      'census_section',
      'census_group',
      'census_item',
      'census_action',
      'ag_census_page',
      'agc_section',
      'agc_resource_item',
      'agc_action_link',
    ], TRUE)) {
      $field_config->delete();
    }
  }

  foreach (FieldStorageConfig::loadMultiple() as $field_storage) {
    $name = $field_storage->getName();
    $target_type = $field_storage->getTargetEntityTypeId();
    if ((str_starts_with($name, 'census_') || in_array($name, nass_census_agcensus_field_names(), TRUE)) && in_array($target_type, ['node', 'paragraph'], TRUE)) {
      $field_storage->delete();
    }
  }

  \Drupal::service('cache.discovery')->deleteAll();
  \Drupal::service('cache.config')->deleteAll();
}

/**
 * Removes retired Census metadata/action fields for the simplified v2 model.
 */
function nass_census_update_10001(): void {
  $field_names = [
    ['paragraph', 'census_action', 'census_action_label'],
    ['paragraph', 'census_action', 'census_action_type'],
    ['paragraph', 'census_action', 'census_action_new_window'],
    ['node', 'census', 'census_issuing_agency'],
    ['node', 'census', 'census_rights'],
    ['node', 'census_publication', 'census_issuing_agency'],
    ['node', 'census_publication', 'census_rights'],
  ];

  foreach ($field_names as [$entity_type, $bundle, $field_name]) {
    if ($field = FieldConfig::loadByName($entity_type, $bundle, $field_name)) {
      $field->delete();
    }
  }

  $storage_names = [
    ['paragraph', 'census_action_label'],
    ['paragraph', 'census_action_type'],
    ['paragraph', 'census_action_new_window'],
    ['node', 'census_issuing_agency'],
    ['node', 'census_rights'],
  ];

  foreach ($storage_names as [$entity_type, $field_name]) {
    if ($storage = FieldStorageConfig::loadByName($entity_type, $field_name)) {
      $storage->delete();
    }
  }

  \Drupal::service('cache.discovery')->deleteAll();
  \Drupal::service('cache.config')->deleteAll();
}

/**
 * Hides managed-display labels and repairs Field Group form-display metadata.
 */
function nass_census_update_10002(): void {
  nass_census_hide_census_display_labels();
  nass_census_repair_field_group_context_and_tabs();

  \Drupal::service('cache.discovery')->deleteAll();
  \Drupal::service('cache.config')->deleteAll();
}

/**
 * Sets field labels to hidden for Census node and paragraph view displays.
 */
function nass_census_hide_census_display_labels(): void {
  $display_ids = [
    'node.census.default',
    'paragraph.census_section.default',
    'paragraph.census_action.default',
    'paragraph.census_group.default',
    'paragraph.census_item.default',
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('entity_view_display');
  foreach ($display_ids as $display_id) {
    $display = $storage->load($display_id);
    if (!$display) {
      continue;
    }

    $changed = FALSE;
    foreach ($display->getComponents() as $field_name => $component) {
      if (($component['label'] ?? NULL) !== 'hidden') {
        $component['label'] = 'hidden';
        $display->setComponent($field_name, $component);
        $changed = TRUE;
      }
    }

    if ($changed) {
      $display->save();
    }
  }
}

/**
 * Adds the required Field Group context key and normalizes Census edit tabs.
 */
function nass_census_repair_field_group_context_and_tabs(): void {
  $config_factory = \Drupal::configFactory();

  foreach ($config_factory->listAll('field.group.') as $name) {
    if (!str_contains($name, '.census') && !str_contains($name, '.census_')) {
      continue;
    }
    $config = $config_factory->getEditable($name);
    if (!$config->get('context')) {
      $config->set('context', 'form');
      $config->save(TRUE);
    }
  }

  // Remove the previous v1.0 Census tab machine names so the editor UI does
  // not keep duplicate/obsolete groups in active config.
  foreach ([
    'field.group.node.census.default.group_sections',
    'field.group.node.census.default.group_migration_admin',
  ] as $old_group_name) {
    $old_group = $config_factory->getEditable($old_group_name);
    if (!$old_group->isNew()) {
      $old_group->delete();
    }
  }

  $base = [
    'langcode' => 'en',
    'status' => TRUE,
    'dependencies' => [
      'config' => ['core.entity_form_display.node.census.default'],
      'module' => ['field_group'],
    ],
    'entity_type' => 'node',
    'bundle' => 'census',
    'mode' => 'default',
    'content' => [],
    'region' => 'content',
    'context' => 'form',
  ];

  $groups = [
    'field.group.node.census.default.group_tabs' => $base + [
      'id' => 'node.census.default.group_tabs',
      'group_name' => 'group_tabs',
      'label' => 'Census editor tabs',
      'children' => ['group_information', 'group_other_information_sections', 'group_other'],
      'parent_name' => '',
      'weight' => 0,
      'format_type' => 'tabs',
      'format_settings' => [
        'direction' => 'horizontal',
        'width_breakpoint' => 640,
      ],
    ],
    'field.group.node.census.default.group_information' => $base + [
      'id' => 'node.census.default.group_information',
      'group_name' => 'group_information',
      'label' => 'Main Information',
      'children' => ['title', 'census_year', 'census_description', 'census_information_links'],
      'parent_name' => 'group_tabs',
      'weight' => 0,
      'format_type' => 'tab',
      'format_settings' => [
        'classes' => '',
        'show_empty_fields' => FALSE,
        'id' => '',
        'formatter' => 'open',
        'description' => '',
        'required_fields' => TRUE,
      ],
    ],
    'field.group.node.census.default.group_other_information_sections' => $base + [
      'id' => 'node.census.default.group_other_information_sections',
      'group_name' => 'group_other_information_sections',
      'label' => 'Other Information Sections',
      'children' => ['census_sections'],
      'parent_name' => 'group_tabs',
      'weight' => 1,
      'format_type' => 'tab',
      'format_settings' => [
        'classes' => '',
        'show_empty_fields' => FALSE,
        'id' => '',
        'formatter' => 'closed',
        'description' => '',
        'required_fields' => TRUE,
      ],
    ],
    'field.group.node.census.default.group_other' => $base + [
      'id' => 'node.census.default.group_other',
      'group_name' => 'group_other',
      'label' => 'Other',
      'children' => ['census_legacy_id', 'census_source_url'],
      'parent_name' => 'group_tabs',
      'weight' => 2,
      'format_type' => 'tab',
      'format_settings' => [
        'classes' => '',
        'show_empty_fields' => FALSE,
        'id' => '',
        'formatter' => 'closed',
        'description' => '',
        'required_fields' => TRUE,
      ],
    ],
  ];

  foreach ($groups as $name => $values) {
    $config = $config_factory->getEditable($name);
    foreach ($values as $key => $value) {
      $config->set($key, $value);
    }
    $config->save(TRUE);
  }

  // Keep the raw Other Information field out of the edit form for this v1.1
  // editorial model. Existing values are preserved; the field is only hidden.
  $form_display = $config_factory->getEditable('core.entity_form_display.node.census.default');
  if (!$form_display->isNew()) {
    $content = $form_display->get('content') ?: [];
    unset($content['census_other_information']);
    $hidden = $form_display->get('hidden') ?: [];
    $hidden['census_other_information'] = TRUE;

    $weights = [
      'census_year' => 1,
      'census_description' => 2,
      'census_information_links' => 3,
      'census_sections' => 4,
      'census_legacy_id' => 5,
      'census_source_url' => 6,
    ];
    foreach ($weights as $field_name => $weight) {
      if (isset($content[$field_name])) {
        $content[$field_name]['weight'] = $weight;
        $content[$field_name]['region'] = 'content';
      }
    }

    $form_display
      ->set('content', $content)
      ->set('hidden', $hidden)
      ->save(TRUE);
  }
}


/**
 * Applies the v1.1 Census editor Field Group tabs and dependency cleanup.
 */
function nass_census_update_10003(): void {
  nass_census_repair_field_group_context_and_tabs();

  $config_factory = \Drupal::configFactory();

  // Clean stale theme registrations/settings that may remain in migrated DBs
  // after Tara/Renatek code was removed from the codebase.
  $extension = $config_factory->getEditable('core.extension');
  $themes = $extension->get('theme') ?: [];
  unset($themes['tara'], $themes['renatek']);
  $extension->set('theme', $themes)->save(TRUE);

  $system_theme = $config_factory->getEditable('system.theme');
  if (in_array($system_theme->get('default'), ['tara', 'renatek'], TRUE)) {
    $system_theme->set('default', 'nass');
  }
  if (in_array($system_theme->get('admin'), ['tara', 'renatek'], TRUE)) {
    $system_theme->set('admin', 'adminimal_theme');
  }
  $system_theme->save(TRUE);

  foreach (['theme.settings.tara', 'theme.settings.renatek'] as $theme_settings) {
    $config = $config_factory->getEditable($theme_settings);
    if (!$config->isNew()) {
      $config->delete();
    }
  }

  \Drupal::service('cache.discovery')->deleteAll();
  \Drupal::service('cache.config')->deleteAll();
}


/**
 * Rebuilds Census node content types from v1.3 normalized census_* config.
 *
 * This is intentionally destructive for Census/Census Publication test content and
 * node field config. It removes the UI-created field_* variants and reinstalls
 * the module-owned census_* content type configuration.
 */
function nass_census_update_10004(): void {
  nass_census_v12_rebuild_node_content_model();

  \Drupal::service('cache.discovery')->deleteAll();
  \Drupal::service('cache.config')->deleteAll();
  \Drupal::entityTypeManager()->clearCachedDefinitions();
}

/**
 * Deletes node content/config drift and imports v1.3 node config files.
 */
function nass_census_v12_rebuild_node_content_model(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $config_factory = \Drupal::configFactory();

  // Delete content first so field storage/type deletion is not blocked by data.
  if (\Drupal::moduleHandler()->moduleExists('node')) {
    $node_storage = $entity_type_manager->getStorage('node');
    $nids = $node_storage->getQuery()
      ->condition('type', ['census', 'census_publication', 'ag_census_page'], 'IN')
      ->accessCheck(FALSE)
      ->execute();
    if ($nids) {
      $node_storage->delete($node_storage->loadMultiple($nids));
    }
  }

  // Remove FieldConfig entities for both the desired names and the accidental
  // UI-created field_* names.
  $node_bundles = ['census', 'census_publication'];
  $field_names = [
    'census_description',
    'census_year',
    'census_information_links',
    'census_legacy_id',
    'census_sections',
    'census_source_url',
    'census_parent_census',
    'census_primary_media',
    'census_publication_kind',
    'census_related_publications',
    'census_within',
    'field_census_description',
    'field_census_year',
    'field_informational_links',
  ];

  foreach ($node_bundles as $bundle) {
    foreach ($field_names as $field_name) {
      if ($field = FieldConfig::loadByName('node', $bundle, $field_name)) {
        $field->delete();
      }
    }
  }

  foreach ($field_names as $field_name) {
    if ($storage = FieldStorageConfig::loadByName('node', $field_name)) {
      $storage->delete();
    }
  }

  // Remove active config that commonly keeps Drupal from importing the clean
  // field names during an iterative local rebuild.
  $prefixes = [
    'field.group.node.census.',
    'field.group.node.census_publication.',
    'core.entity_form_display.node.census',
    'core.entity_form_display.node.census_publication',
    'core.entity_view_display.node.census',
    'core.entity_view_display.node.census_publication',
    'field.field.node.census.',
    'field.field.node.census_publication.',
    'field.storage.node.census_',
    'field.storage.node.field_census',
    'field.storage.node.field_informational_links',
    'node.type.census',
    'node.type.census_publication',
  ];
  foreach ($prefixes as $prefix) {
    foreach ($config_factory->listAll($prefix) as $name) {
      $config_factory->getEditable($name)->delete();
    }
  }

  // Import just the v1.3 node/content-type configs from this module's
  // config/install directory. Paragraph configs are intentionally left alone in
  // this update because v1.3 only normalizes the content types.
  $module_path = \Drupal::service('extension.list.module')->getPath('nass_census');
  $config_path = DRUPAL_ROOT . '/' . $module_path . '/config/install';
  $files = [
    'taxonomy.vocabulary.census_year.yml',
    'node.type.census.yml',
    'node.type.census_publication.yml',
    'field.storage.node.census_description.yml',
    'field.storage.node.census_year.yml',
    'field.storage.node.census_information_links.yml',
    'field.storage.node.census_legacy_id.yml',
    'field.storage.node.census_sections.yml',
    'field.storage.node.census_source_url.yml',
    'field.storage.node.census_parent_census.yml',
    'field.storage.node.census_primary_media.yml',
    'field.storage.node.census_publication_kind.yml',
    'field.storage.node.census_related_publications.yml',
    'field.storage.node.census_within.yml',
    'field.field.node.census.census_description.yml',
    'field.field.node.census.census_year.yml',
    'field.field.node.census.census_information_links.yml',
    'field.field.node.census.census_legacy_id.yml',
    'field.field.node.census.census_sections.yml',
    'field.field.node.census.census_source_url.yml',
    'field.field.node.census_publication.census_description.yml',
    'field.field.node.census_publication.census_year.yml',
    'field.field.node.census_publication.census_legacy_id.yml',
    'field.field.node.census_publication.census_parent_census.yml',
    'field.field.node.census_publication.census_primary_media.yml',
    'field.field.node.census_publication.census_publication_kind.yml',
    'field.field.node.census_publication.census_related_publications.yml',
    'field.field.node.census_publication.census_sections.yml',
    'field.field.node.census_publication.census_source_url.yml',
    'field.field.node.census_publication.census_within.yml',
    'core.entity_form_display.node.census.default.yml',
    'core.entity_form_display.node.census_publication.default.yml',
    'core.entity_view_display.node.census.default.yml',
    'core.entity_view_display.node.census_publication.default.yml',
    'field.group.node.census.default.group_tabs.yml',
    'field.group.node.census.default.group_information.yml',
    'field.group.node.census.default.group_other_information_sections.yml',
    'field.group.node.census.default.group_other.yml',
    'field.group.node.census_publication.default.group_tabs.yml',
    'field.group.node.census_publication.default.group_information.yml',
    'field.group.node.census_publication.default.group_context.yml',
    'field.group.node.census_publication.default.group_sections.yml',
    'field.group.node.census_publication.default.group_migration_admin.yml',
  ];

  foreach ($files as $file) {
    $full_path = $config_path . '/' . $file;
    if (!file_exists($full_path)) {
      continue;
    }
    $name = substr($file, 0, -4);
    $data = \Drupal\Component\Serialization\Yaml::decode(file_get_contents($full_path));
    unset($data['uuid'], $data['_core']);
    $config_factory->getEditable($name)->setData($data)->save(TRUE);
  }
}


/**
 * Repairs node Field Group tabs and creates the required Census Year term.
 */
function nass_census_update_10005(): void {
  nass_census_v13_ensure_census_year_term();
  nass_census_v13_ensure_census_year_required();
  nass_census_v13_repair_node_form_displays_and_groups();

  \Drupal::service('cache.discovery')->deleteAll();
  \Drupal::service('cache.config')->deleteAll();
  \Drupal::entityTypeManager()->clearCachedDefinitions();
}

/**
 * Creates the default Census Year vocabulary term used by required year fields.
 */
function nass_census_v13_ensure_census_year_term(): void {
  if (!\Drupal::moduleHandler()->moduleExists('taxonomy')) {
    return;
  }

  $vocabulary = \Drupal::entityTypeManager()->getStorage('taxonomy_vocabulary')->load('census_year');
  if (!$vocabulary) {
    $config_path = DRUPAL_ROOT . '/' . \Drupal::service('extension.list.module')->getPath('nass_census') . '/config/install/taxonomy.vocabulary.census_year.yml';
    if (file_exists($config_path)) {
      $data = \Drupal\Component\Serialization\Yaml::decode(file_get_contents($config_path));
      unset($data['uuid'], $data['_core']);
      \Drupal::configFactory()->getEditable('taxonomy.vocabulary.census_year')->setData($data)->save(TRUE);
    }
  }

  $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties([
    'vid' => 'census_year',
    'name' => '2022',
  ]);
  if (!$terms) {
    Term::create([
      'vid' => 'census_year',
      'name' => '2022',
      'status' => 1,
    ])->save();
  }
}

/**
 * Makes Census Year required on both node bundles.
 */
function nass_census_v13_ensure_census_year_required(): void {
  foreach (['census', 'census_publication'] as $bundle) {
    if ($field = FieldConfig::loadByName('node', $bundle, 'census_year')) {
      $field->setRequired(TRUE)->save();
    }
    $config_name = 'field.field.node.' . $bundle . '.census_year';
    $config = \Drupal::configFactory()->getEditable($config_name);
    if (!$config->isNew()) {
      $config->set('required', TRUE)->save(TRUE);
    }
  }
}

/**
 * Reimports the node form displays and Field Group config from module config.
 */
function nass_census_v13_repair_node_form_displays_and_groups(): void {
  $config_factory = \Drupal::configFactory();
  $module_path = \Drupal::service('extension.list.module')->getPath('nass_census');
  $config_path = DRUPAL_ROOT . '/' . $module_path . '/config/install';

  $files = [
    'core.entity_form_display.node.census.default.yml',
    'core.entity_form_display.node.census_publication.default.yml',
    'field.group.node.census.default.group_tabs.yml',
    'field.group.node.census.default.group_information.yml',
    'field.group.node.census.default.group_other_information_sections.yml',
    'field.group.node.census.default.group_other.yml',
    'field.group.node.census_publication.default.group_tabs.yml',
    'field.group.node.census_publication.default.group_information.yml',
    'field.group.node.census_publication.default.group_context.yml',
    'field.group.node.census_publication.default.group_sections.yml',
    'field.group.node.census_publication.default.group_migration_admin.yml',
  ];

  foreach ($files as $file) {
    $full_path = $config_path . '/' . $file;
    if (!file_exists($full_path)) {
      continue;
    }
    $name = substr($file, 0, -4);
    $data = \Drupal\Component\Serialization\Yaml::decode(file_get_contents($full_path));
    unset($data['uuid'], $data['_core']);
    $config_factory->getEditable($name)->setData($data)->save(TRUE);
  }
}


/**
 * v1.4: Repairs Field Group display metadata on node form displays.
 *
 * Field Group is rendered from the entity form display third_party_settings on
 * this site. The standalone field.group.* config entities alone are not enough.
 */
function nass_census_update_10006(): void {
  nass_census_v14_repair_field_group_display_metadata();

  \Drupal::service('cache.discovery')->deleteAll();
  \Drupal::service('cache.config')->deleteAll();
  \Drupal::entityTypeManager()->clearCachedDefinitions();
}

/**
 * Imports v1.4 form displays and matching Field Group config entities.
 */
function nass_census_v14_repair_field_group_display_metadata(): void {
  $config_factory = \Drupal::configFactory();
  $module_path = \Drupal::service('extension.list.module')->getPath('nass_census');
  $config_path = DRUPAL_ROOT . '/' . $module_path . '/config/install';

  // Delete obsolete v1.3 tab-style group config that is not used by the latest
  // exported UI configuration.
  foreach ([
    'field.group.node.census.default.group_tabs',
    'field.group.node.census.default.group_information',
    'field.group.node.census.default.group_other_information_sections',
    'field.group.node.census.default.group_other',
    'field.group.node.census.default.group_sections',
    'field.group.node.census.default.group_migration_admin',
    'field.group.node.census_publication.default.group_tabs',
    'field.group.node.census_publication.default.group_information',
    'field.group.node.census_publication.default.group_context',
    'field.group.node.census_publication.default.group_migration_admin',
  ] as $name) {
    $config = $config_factory->getEditable($name);
    if (!$config->isNew()) {
      $config->delete();
    }
  }

  $files = [
    'core.entity_form_display.node.census.default.yml',
    'core.entity_form_display.node.census_publication.default.yml',
    'field.group.node.census.default.group_census_information.yml',
    'field.group.node.census.default.group_census_sections.yml',
    'field.group.node.census.default.group_other_information.yml',
    'field.group.node.census_publication.default.group_census_section_information.yml',
    'field.group.node.census_publication.default.group_sections.yml',
    'field.group.node.census_publication.default.group_publications.yml',
    'field.group.node.census_publication.default.group_other_information.yml',
  ];

  foreach ($files as $file) {
    $full_path = $config_path . '/' . $file;
    if (!file_exists($full_path)) {
      continue;
    }
    $name = substr($file, 0, -4);
    $data = \Drupal\Component\Serialization\Yaml::decode(file_get_contents($full_path));
    unset($data['uuid'], $data['_core']);
    $config_factory->getEditable($name)->setData($data)->save(TRUE);
  }
}

/**
 * Creates the legacy Ag Census importer content model on existing installs.
 */
function nass_census_update_10007(): void {
  nass_census_agcensus_create_content_model();

  \Drupal::service('cache.discovery')->deleteAll();
  \Drupal::service('cache.config')->deleteAll();
  \Drupal::entityTypeManager()->clearCachedDefinitions();
}

/**
 * Creates the content structures used by the merged agcensus_migrator importer.
 *
 * The original agcensus_migrator module created a separate `ag_census_page`
 * content type and three paragraph bundles. Those machine names are preserved
 * so imported content and existing command behavior do not change after the
 * functionality is folded into nass_census.
 */
function nass_census_agcensus_create_content_model(): void {
  nass_census_agcensus_create_node_type();
  nass_census_agcensus_create_paragraph_types();
  nass_census_agcensus_create_fields();
}

/**
 * Creates the Ag Census content type used by the JSON importer.
 */
function nass_census_agcensus_create_node_type(): void {
  if (!NodeType::load('ag_census_page')) {
    NodeType::create([
      'type' => 'ag_census_page',
      'name' => 'Ag Census Page',
      'description' => 'Normalized Census of Agriculture landing and publication pages.',
      'new_revision' => TRUE,
      'display_submitted' => FALSE,
    ])->save();
  }
}

/**
 * Creates the paragraph bundles used by the Ag Census JSON importer.
 */
function nass_census_agcensus_create_paragraph_types(): void {
  $bundles = [
    'agc_section' => 'Ag Census Section',
    'agc_resource_item' => 'Ag Census Resource Item',
    'agc_action_link' => 'Ag Census Action Link',
  ];

  foreach ($bundles as $id => $label) {
    if (!ParagraphsType::load($id)) {
      ParagraphsType::create([
        'id' => $id,
        'label' => $label,
      ])->save();
    }
  }
}

/**
 * Creates field storage and bundle fields required by the Ag Census importer.
 */
function nass_census_agcensus_create_fields(): void {
  // Node fields.
  nass_census_agcensus_ensure_field_storage('node', 'field_census_year', 'integer', []);
  nass_census_agcensus_ensure_field('node', 'ag_census_page', 'field_census_year', 'Census year', [
    'required' => FALSE,
  ]);

  nass_census_agcensus_ensure_field_storage('node', 'field_source_variant', 'list_string', [
    'settings' => [
      'allowed_values' => [
        'current' => 'Current design',
        'publication' => 'Publication design',
        'archive' => 'Archive design',
      ],
    ],
  ]);
  nass_census_agcensus_ensure_field('node', 'ag_census_page', 'field_source_variant', 'Source variant', [
    'required' => FALSE,
  ]);

  nass_census_agcensus_ensure_field_storage('node', 'field_source_url', 'link', []);
  nass_census_agcensus_ensure_field('node', 'ag_census_page', 'field_source_url', 'Source URL', []);

  nass_census_agcensus_ensure_field_storage('node', 'field_release_date', 'datetime', [
    'settings' => ['datetime_type' => 'date'],
  ]);
  nass_census_agcensus_ensure_field('node', 'ag_census_page', 'field_release_date', 'Release date', []);

  nass_census_agcensus_ensure_field_storage('node', 'field_summary', 'text_long', []);
  nass_census_agcensus_ensure_field('node', 'ag_census_page', 'field_summary', 'Summary', []);

  nass_census_agcensus_ensure_field_storage('node', 'field_legacy_html', 'text_long', []);
  nass_census_agcensus_ensure_field('node', 'ag_census_page', 'field_legacy_html', 'Legacy HTML snapshot', []);

  nass_census_agcensus_ensure_field_storage('node', 'field_sections', 'entity_reference_revisions', [
    'cardinality' => -1,
    'settings' => [
      'target_type' => 'paragraph',
    ],
  ]);
  nass_census_agcensus_ensure_field('node', 'ag_census_page', 'field_sections', 'Sections', [
    'settings' => [
      'handler' => 'default:paragraph',
      'handler_settings' => [
        'target_bundles' => [
          'agc_section' => 'agc_section',
        ],
      ],
    ],
  ]);

  // Shared section/item fields.
  nass_census_agcensus_ensure_field_storage('paragraph', 'field_heading', 'string', ['settings' => ['max_length' => 255]]);
  nass_census_agcensus_ensure_field('paragraph', 'agc_section', 'field_heading', 'Heading', []);
  nass_census_agcensus_ensure_field('paragraph', 'agc_resource_item', 'field_heading', 'Title', []);
  nass_census_agcensus_ensure_field('paragraph', 'agc_action_link', 'field_heading', 'Link label', []);

  nass_census_agcensus_ensure_field_storage('paragraph', 'field_intro', 'text_long', []);
  nass_census_agcensus_ensure_field('paragraph', 'agc_section', 'field_intro', 'Intro', []);
  nass_census_agcensus_ensure_field('paragraph', 'agc_resource_item', 'field_intro', 'Description', []);

  nass_census_agcensus_ensure_field_storage('paragraph', 'field_items', 'entity_reference_revisions', [
    'cardinality' => -1,
    'settings' => [
      'target_type' => 'paragraph',
    ],
  ]);
  nass_census_agcensus_ensure_field('paragraph', 'agc_section', 'field_items', 'Items', [
    'settings' => [
      'handler' => 'default:paragraph',
      'handler_settings' => [
        'target_bundles' => [
          'agc_resource_item' => 'agc_resource_item',
        ],
      ],
    ],
  ]);

  // Resource item fields.
  nass_census_agcensus_ensure_field_storage('paragraph', 'field_group_label', 'string', ['settings' => ['max_length' => 255]]);
  nass_census_agcensus_ensure_field('paragraph', 'agc_resource_item', 'field_group_label', 'Group label', []);

  nass_census_agcensus_ensure_field_storage('paragraph', 'field_item_release_date', 'datetime', [
    'settings' => ['datetime_type' => 'date'],
  ]);
  nass_census_agcensus_ensure_field('paragraph', 'agc_resource_item', 'field_item_release_date', 'Item release date', []);

  nass_census_agcensus_ensure_field_storage('paragraph', 'field_links', 'entity_reference_revisions', [
    'cardinality' => -1,
    'settings' => [
      'target_type' => 'paragraph',
    ],
  ]);
  nass_census_agcensus_ensure_field('paragraph', 'agc_resource_item', 'field_links', 'Links', [
    'settings' => [
      'handler' => 'default:paragraph',
      'handler_settings' => [
        'target_bundles' => [
          'agc_action_link' => 'agc_action_link',
        ],
      ],
    ],
  ]);

  // Action link fields.
  nass_census_agcensus_ensure_field_storage('paragraph', 'field_link_url', 'link', []);
  nass_census_agcensus_ensure_field('paragraph', 'agc_action_link', 'field_link_url', 'URL', []);

  nass_census_agcensus_ensure_field_storage('paragraph', 'field_file_asset', 'file', [
    'settings' => [
      'uri_scheme' => 'public',
      'file_extensions' => 'pdf txt csv xls xlsx zip doc docx',
    ],
    'cardinality' => 1,
  ]);
  nass_census_agcensus_ensure_field('paragraph', 'agc_action_link', 'field_file_asset', 'Downloaded file', []);

  nass_census_agcensus_ensure_field_storage('paragraph', 'field_file_format', 'string', ['settings' => ['max_length' => 32]]);
  nass_census_agcensus_ensure_field('paragraph', 'agc_action_link', 'field_file_format', 'File format', []);
}

/**
 * Ensures a field storage config exists for the merged Ag Census model.
 */
function nass_census_agcensus_ensure_field_storage(string $entity_type, string $field_name, string $field_type, array $overrides): void {
  if (!FieldStorageConfig::loadByName($entity_type, $field_name)) {
    $values = [
      'entity_type' => $entity_type,
      'field_name' => $field_name,
      'type' => $field_type,
    ] + $overrides;
    FieldStorageConfig::create($values)->save();
  }
}

/**
 * Ensures a bundle field config exists for the merged Ag Census model.
 */
function nass_census_agcensus_ensure_field(string $entity_type, string $bundle, string $field_name, string $label, array $overrides): void {
  if (!FieldConfig::loadByName($entity_type, $bundle, $field_name)) {
    $config = [
      'entity_type' => $entity_type,
      'bundle' => $bundle,
      'field_name' => $field_name,
      'label' => $label,
    ] + $overrides;
    FieldConfig::create($config)->save();
  }
}

/**
 * Lists the field machine names owned by the merged Ag Census importer model.
 *
 * These names intentionally preserve the legacy agcensus_migrator `field_*`
 * machine names. The list keeps uninstall cleanup narrow so unrelated site
 * fields that also start with `field_` are not removed.
 *
 * @return array<int, string>
 *   Field storage and bundle field names owned by this module's Ag Census model.
 */
function nass_census_agcensus_field_names(): array {
  return [
    'field_census_year',
    'field_source_variant',
    'field_source_url',
    'field_release_date',
    'field_summary',
    'field_legacy_html',
    'field_sections',
    'field_heading',
    'field_intro',
    'field_items',
    'field_group_label',
    'field_item_release_date',
    'field_links',
    'field_link_url',
    'field_file_asset',
    'field_file_format',
  ];
}
