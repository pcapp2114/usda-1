{#
/**
 * @file
 * Bartik's theme implementation to display a single page.
 *
 * The doctype, html, head and body tags are not in this template. Instead they
 * can be found in the html.html.twig template normally located in the
 * core/modules/system directory.
 *
 * Available variables:
 *
 * General utility variables:
 * - base_path: The base URL path of the Drupal installation. Will usually be
 *   "/" unless you have installed Drupal in a sub-directory.
 * - is_front: A flag indicating if the current page is the front page.
 * - logged_in: A flag indicating if the user is registered and signed in.
 * - is_admin: A flag indicating if the user has permission to access
 *   administration pages.
 *
 * Site identity:
 * - front_page: The URL of the front page. Use this instead of base_path when
 *   linking to the front page. This includes the language domain or prefix.
 *
 * Page content (in order of occurrence in the default page.html.twig):
 * - node: Fully loaded node, if there is an automatically-loaded node
 *   associated with the page and the node ID is the second argument in the
 *   page's path (e.g. node/12345 and node/12345/revisions, but not
 *   comment/reply/12345).
 *
 * Regions:
 * - page.header: Items for the header region.
 * - page.highlighted: Items for the highlighted region.
 * - page.primary_menu: Items for the primary menu region.
 * - page.secondary_menu: Items for the secondary menu region.
 * - page.featured_top: Items for the featured top region.
 * - page.content: The main content of the current page.
 * - page.sidebar_first: Items for the first sidebar.
 * - page.sidebar_second: Items for the second sidebar.
 * - page.featured_bottom_first: Items for the first featured bottom region.
 * - page.featured_bottom_second: Items for the second featured bottom region.
 * - page.featured_bottom_third: Items for the third featured bottom region.
 * - page.footer_first: Items for the first footer column.
 * - page.footer_second: Items for the second footer column.
 * - page.footer_third: Items for the third footer column.
 * - page.footer_fourth: Items for the fourth footer column.
 * - page.footer_fifth: Items for the fifth footer column.
 * - page.breadcrumb: Items for the breadcrumb region.
 *
 * @see template_preprocess_page()
 * @see html.html.twig
 */
#}
{% set url = url('<current>') %}
{% if node.field_hero_background_image.entity is not empty %}
  {% set background_url = file_url(directory ~ '/assets/img/default-hero-background.png') %}
{% else %}
  {% set background_url = file_url(directory ~ '/assets/img/default-hero-background.png') %}
{% endif %}
{% include directory ~ '/templates/layout/header.html.twig' %}
<div class="region region-hero">
  <div class="page-header" style="background-image:url({{background_url}});">
    <div class="grid-container">
      <div class="grid-row">
        {% if node.field_section_heading.value is not empty %}
          <h3>{{node.field_section_heading.value|raw}}</h3>
        {% else %}
          {% if '/about-nass/' in url|render|render %}
            <h3>About NASS</h3>
          {% elseif '/newsroom/' in url|render|render %}
            <h3>Newsroom</h3>
          {% elseif 'about-census' in url|render|render %}
            <h3>About Census & Surveys</h3>
          {% elseif '/data-and-statistics/' in url|render|render %}
            <h3>Data & Statistics</h3>
          {% endif %}
        {% endif %}
      </div>
      <div class="grid-row">
        {% if '/data-and-statistics/state' in url|render|render %}
          <h1>State</h1>
        {% else %}
          <h1>{{page['#title']|raw}}</h1>
        {% endif %}
      </div>
    </div>
  </div>
  <div class="grid-container">
    {{ drupal_block('system_breadcrumb_block') }}
  </div>
</div>
<div id="main-wrapper" class="layout-main-wrapper layout-container clearfix">
  <div id="main" class="layout-main clearfix">
    <main id="content" class="column main-content grid-container" role="main">
      <div class="grid-row grid-gap">
        {# see https://www.drupal.org/project/drupal/issues/953034#comment-14192130 #}
        {% if page.sidebar_first|render|striptags('<img><video><audio><drupal-render-placeholder>')|trim %}
          <aside class="tablet:grid-col-3">
            {{ page.sidebar_first }}
          </aside>
        {% endif %}

        <div class="region-content {{ content_class }}">
          {{ page.help }}
          <p>This is some helpful text about QuickStats.</p>

          <div id="quickstats">
        
            <!-- start quickstats3 form -->
            <div class="clearfix">
              <form id="quickstats3" method="get" action="./result.php">
                      <ul id="tabnav">
                            <li class="tab1"><a>U.S. & State Level Data</a></li>
                            <li class="tab2"><a href="index2.php">County Level Data</a></li>
                            <li class="tab3"><a href="#">Ag. District Level Data</a></li>
                          </ul>
                      </div-->
                      <div class="subheading">
                          Select Sector - Group - Commodity - View
                          <br clear="all">
                          <div style="float:left; display:inline;cursor:pointer;margin:3px;font-size:11px" id="Commodityhelp">
                          (select one item from each box) &nbsp;
                          <img style="display:inline;" alt="Online Help" src="./images/icon_help_bubble.gif" onclick="toggleHelp('Commodity_help');">
                      </div>
                      <div class="contextHelp" id="Commodity_help" style="display: none;">
                          <div onclick="toggleHelp('Commodity_help');" id="closeSearchHints">Close(X)</div>
                          <br clear="all">
                          <p>
                              Quick Stats lets you create queries based on the simple filtering rules of <em>What, Where</em>, and <em>When</em>.
                          </p>
                          <p>
                          <strong>Select Commodity</strong> is the <em>What</em>. Click on a value from any visible item list to start your query.  The remaining visible unselected item lists will filter and refresh based on your choices. If the updated fields in the Select Commodity area are satisfactory, you will not have to make more selections in this area unless you want to fine tune your search.</p>
                      </div>
                      </div>
                      <br clear="all">
                      <div id="sector_div" class="selectGroup" style="display:''" >
                          <label class="selectLabel" class="selectLabel" for="SECTOR_DESC">Sector</label>
                      <div id="sectordesc" class="selectOption" style="display:''">
                          <select name="SECTOR_DESC" id="SECTOR_DESC" size=5 onChange="updateMenu1('SECTOR_DESC');">
                              <option value="ANIMALS & PRODUCTS">ANIMALS &amp; PRODUCTS</option>
                              <option value="CROPS">CROPS</option>
                              <option value="ECONOMICS">ECONOMICS</option>
                              <option value="ENVIRONMENTAL">ENVIRONMENTAL</option>
                          </select>
                      </div>
                      </div>
                      <div id="group_div" class="selectGroup" style="display:none ; border:0px green solid;">
                          <label class="selectLabel" for="GROUP_DESC">Group</label>
                      <div id="groupdesc" class="selectOption" style="border: 0px red dashed;">
                          <!--group desc here ... -->
                          <select name="GROUP_DESC" id="GROUP_DESC" multiple size=5 onChange="updateMenu1('GROUP_DESC');"> <!--onChange="updateMenu1('GROUP_DESC');"-->
                          </select>
                      </div>
                      </div>
                      <div id="commodity_div" class="selectGroup" style="display:none">
                          <label class="selectLabel" for="COMMODITY_DESC">Commodity</label>
                      <div id="commoditydesc" class="selectOption">
                          <!--commodity desc here ...-->
                          <select name="COMMODITY_DESC" id="COMMODITY_DESC" multiple size=5>
                          </select>
                      </div>
                      </div>
                      <!--div class="subheading">Select Report Type - Commodity(ies)</div-->
                      <br clear="all">
                      <br clear="all">
                      <div id="report_div" class="selectGroup" style="display:none">
                          <label class="selectLabel" for="REPORT_NAME">View</label>
                      <div id="reportname" class="selectOption">
                          <select id="REPORT_NAME" name="REPORT_NAME" multiple size=5 >
                          </select>
                      </div>
                      </div>
                      <!--prev. commodity here -->
                      <br clear="all">
                      <div id="yearloc" class="subheading" style="display:none">
                          Select Year - Geographic Level - State - Location
                          <br clear="all">
                          <div style="float:left;cursor:pointer;margin:3px;font-size:11px" id="YearLocationHelp">
                          (select one or more items from each box) &nbsp;
                          <img style="display:inline;" alt="Online Help" src="./images/icon_help_bubble.gif" onclick="toggleHelp('Year_Location_help');">
                          </div>
                          <div class="contextHelp" id="Year_Location_help" style="display: none;">
                              <div onclick="toggleHelp('Year_Location_help');" id="closeSearchHints2">Close(X)</div>
                              <br clear="all">
                              <p>
                              <span style="display: none" _fck_bookmark="1">&nbsp;</span><span style="display: none" _fck_bookmark="1"> </span>Quick Stats lets you create queries based on the simple filtering rules of <em>What, Where, </em>and<em> When</em>.</p>
                              <p>
                              <strong>Select Location</strong> is the <em>Where</em>. Click on a value from any visible item list to start your query.  The remaining visible unselected item lists will filter and refresh based on your choices. If the updated fields in the Select Location area are satisfactory, you will not have to make more selections in this area unless you want to fine tune your search.</p>
                              <p>
                                  If you would like to select more than one item in any of the data fields, hold the <strong>Ctrl</strong> key on your keyboard and click on any other items of the same field that you would like to use.&nbsp; You may also hold the <strong>Shift</strong> key and select an upper and lower value of a data field to select the entire range.&nbsp;<span style="display: none" _fck_bookmark="1"> </span>
                              </p>
                          </div>
                      </div>
                      <br clear="all">
                      <div id="year_div" class="selectGroup" style="display:none">
                          <label class="selectLabel" for="YEAR">Year</label>
                      <div id="year_" class="selectOption">
                            <select name="YEAR" id="YEAR" multiple size=5>
                            </select>
                      </div>
                      </div>
                  <!-- dp 1/20/12 -->
                  <!-- agg_level -->
                  <div id="agg_div" class="selectGroup" style="display:none">
                          <label class="selectLabel" for="AGG_LEVEL_DESC">Geographic Level</label>
                      <div id="agglevel_desc" class="selectOption">
                          <select name="AGG_LEVEL_DESC" id="AGG_LEVEL_DESC" size=5>
                          </select>
                      </div>
                      </div>
                      <!---- State name --- -->
                  <div id="state_div" class="selectGroup" style="display:none">
                          <label class="selectLabel" for="STATE_NAME">State Name</label>
                      <div id="statename" class="selectOption">
                          <select name="STATE_NAME" id="STATE_NAME" multiple size=5>
                          </select>
                      </div>
                      </div>
                  <!-- location desc --->
                  <div id="location_div" class="selectGroup" style="display:none">
                          <label class="selectLabel" for="LOCATION_DESC">Selected Location</label>
                      <div id="locationdesc" class="selectOption">
                          <!--commodity desc here ...-->
                          <select name="LOCATION_DESC" id="LOCATION_DESC" multiple size=5>
                          </select>
                      </div>
                  </div>
                  <!-- submit button-->
                  <br clear="all"/>
                  <div class="subheading">&nbsp;</div>
                  <br clear="all"/>
                  <input id="getdata" type="button" value="Get Data" alt="Get Data"  disabled="true"  onClick='onSubmit();'>
                  <p>&nbsp;</p>
                  </div>
              </form>
            </div>

            {# <div class="grid-row">
              <div class="tablet:grid-col">
                <label class="usa-label" for="sector">Sector</label>
                <select class="usa-select" name="sector" id="sector">
                  <option value>Select a sector</option>
                </select>
              </div>
              <div class="tablet:grid-col">
                <label class="usa-label" for="group">Group</label>
                <select class="usa-select" name="group" id="group">
                  <option value>Select a group</option>
                </select>
              </div>
              <div class="tablet:grid-col">
                <label class="usa-label" for="commodity">Commodity</label>
                <select class="usa-select" name="commodity" id="commodity">
                  <option value>Select a commodity</option>
                </select>
              </div>
            </div> #}
          </div>

        </div>
        {# see https://www.drupal.org/project/drupal/issues/953034#comment-14192130 #}
        {% if page.sidebar_second|render|striptags('<img><video><audio><drupal-render-placeholder>')|trim %}
          <aside class="tablet:grid-col-3">
            {{ page.sidebar_second }}
          </aside>
        {% endif %}
      </div>
    </main>
  </div>
</div>

{% include directory ~ '/templates/layout/footer.html.twig' %}
