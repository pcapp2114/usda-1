<?php

/**
 * Implements hook_page_attachments().
 */
function nass_release_page_attachments(array &$variables){
  // Unconditionally attach an asset to the page.
  $variables['#attached']['library'][] = 'nass_release/nass_release';
}

/**
 * Implements hook_preprocess_page().
 */
function nass_release_preprocess(&$variables) {
  global $base_root, $base_path;
  // Define path to image directory within module
  $variables['image_path'] = $base_root . $base_path . drupal_get_path('module', 'nass_release') . '/images/';
}

/**
 * Implements hook_theme().
 */
function nass_release_theme($theme) {
  $theme['block__nass_release'] = [
    'template' => 'block--nass-release',
  ];

	return $theme;
}