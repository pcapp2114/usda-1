<?php

/**
 * Implements hook_page_attachments().
 */
function nass_release_page_attachments(array &$page): void {
  $page['#attached']['library'][] = 'nass_release/nass_release';
  $page['#attached']['drupalSettings']['nassRelease'] = \Drupal::service('nass_release.attachment_builder')->build();
}

/**
 * Implements hook_cron().
 */
function nass_release_cron(): void {
  $config = \Drupal::config('nass_release.adminsettings');
  if ($config->get('tx_rebuild_snapshot_on_cron') !== FALSE) {
    \Drupal::service('nass_release.tx_snapshot_manager')->scan(FALSE);
  }
}

/**
 * Implements hook_preprocess().
 */
function nass_release_preprocess(&$variables): void {
  $config = \Drupal::config('nass_release.adminsettings');

  $textarea_top = $config->get('nass_release_textarea_page_top');
  $textarea_bottom = $config->get('nass_release_textarea_page_bottom');

  $variables['todays_release_top_content'] = is_array($textarea_top) ? ($textarea_top['value'] ?? '') : '';
  $variables['todays_release_bottom_content'] = is_array($textarea_bottom) ? ($textarea_bottom['value'] ?? '') : '';
  $variables['todays_release_disabled'] = $config->get('nass_release_disabled_message') ?: '';
  $variables['todays_release_toggle'] = $config->get('nass_release_on_off_toggle') ?? 1;
}

/**
 * Implements hook_theme().
 */
function nass_release_theme($existing, $type, $theme, $path): array {
  return [
    'nass_release_todays_release' => [
      'variables' => [
        'enabled' => TRUE,
        'disabled_message' => '',
        'today_date' => '',
        'today_releases' => [],
        'upcoming_releases' => [],
        'no_release_message' => '',
        'calendar_url' => '/data-and-statistics/calendar/release-calendar',
      ],
      'template' => 'nass-release-todays-release',
    ],

    'nass_release_calendar_page' => [
      'variables' => [
        'events_by_date' => [],
        'month_label' => '',
        'month' => '',
        'previous_month_url' => '',
        'next_month_url' => '',
        'calendar_days' => [],
      ],
      'template' => 'nass-release-calendar-page',
    ],
    'block__nass_release_state_select' => [],
    'block__nass_release_todays_release' => [],
    'block__nass_release_whats_new' => [],
    'block__nass_release_year_list' => [],
  ];
}
