<div id="todays-releases" class="release-block">
  <div class="release-block-inner-wrap">
    <div class="todays-releases">
      <h2 class="overline-header">TODAY'S <span>RELEASES</span></h2>
      <div class="release-info">
        <div class="release" id="todays-release-wrap">
          <h3 class="release-main-date">{{'now'|date('M d, Y', 'America/New_York') }}</h3>
        </div>
      </div>
    </div>
    <div class="upcoming-release">
      <h3>UPCOMING RELEASES</h3>
      <div class="release-info">
        <div class="release" id="upcoming-release-data">
          {# //{{ drupal_view('release_calendar', 'upcoming_releases') }} #}
          <div class="release-calendar"><button type="" class="usa-button usa-button--outline"><a href="/data-and-statistics/calendar/release-calendar" class="">View Release Calendar</a></button></div>
        </div>
      </div>
    </div>
  </div>
</div>