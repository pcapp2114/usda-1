<?php

declare(strict_types=1);

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\field\Entity\FieldStorageConfigInterface;
use Drupal\field\Entity\FieldConfigInterface;
use Drupal\field_group\FieldGroupInterface;
use Drupal\node\Entity\NodeType;
use Drupal\paragraphs\Entity\ParagraphsType;
use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;

/**
 * Implements hook_install().
 */
function census_install(): void {
  census_create_content_types();
  census_create_paragraph_types();
  census_create_field_storages();
  census_attach_fields();
  census_configure_form_displays();
  census_configure_view_displays();
}

/**
 * Creates node bundles.
 */
function census_create_content_types(): void {
  $types = [
    'census' => [
      'name' => 'Census',
      'description' => 'Year-level Census landing page.',
    ],
    'census_publication' => [
      'name' => 'Census Publication',
      'description' => 'Child/detail page for Census reports, profiles, studies, and selector pages.',
    ],
  ];

  foreach ($types as $machine_name => $definition) {
    if (!NodeType::load($machine_name)) {
      NodeType::create([
        'type' => $machine_name,
        'name' => $definition['name'],
        'description' => $definition['description'],
        'new_revision' => TRUE,
        'display_submitted' => FALSE,
      ])->save();
    }
  }
}

/**
 * Creates paragraph bundles.
 */
function census_create_paragraph_types(): void {
  $bundles = [
    'census_section' => 'Census Section',
    'census_group' => 'Census Group',
    'census_item' => 'Census Item',
    'census_action' => 'Census Action',
  ];

  foreach ($bundles as $id => $label) {
    if (!ParagraphsType::load($id)) {
      ParagraphsType::create([
        'id' => $id,
        'label' => $label,
      ])->save();
    }
  }
}

/**
 * Creates all shared field storages.
 */
function census_create_field_storages(): void {
  $storages = [
    'node' => [
      'census_year' => ['type' => 'integer'],
      'census_issuing_agency' => ['type' => 'string', 'settings' => ['max_length' => 255]],
      'census_rights' => ['type' => 'string', 'settings' => ['max_length' => 255]],
      'census_description' => ['type' => 'text_long'],
      'census_information_links' => ['type' => 'entity_reference_revisions', 'cardinality' => -1, 'settings' => ['target_type' => 'paragraph']],
      'census_other_information' => ['type' => 'text_long'],
      'census_source_url' => ['type' => 'link'],
      'census_sections' => ['type' => 'entity_reference_revisions', 'cardinality' => -1, 'settings' => ['target_type' => 'paragraph']],
      'census_legacy_id' => ['type' => 'string', 'settings' => ['max_length' => 255]],
      'census_publication_kind' => ['type' => 'list_string', 'settings' => ['allowed_values' => census_allowed_values_publication_kind()]],
      'census_within' => ['type' => 'string', 'settings' => ['max_length' => 255]],
      'census_parent_census' => ['type' => 'entity_reference', 'settings' => ['target_type' => 'node']],
      'census_related_publications' => ['type' => 'entity_reference', 'cardinality' => -1, 'settings' => ['target_type' => 'node']],
      'census_primary_media' => ['type' => 'entity_reference', 'settings' => ['target_type' => 'media']],
    ],
    'paragraph' => [
      'census_section_title' => ['type' => 'string', 'settings' => ['max_length' => 255]],
      'census_section_key' => ['type' => 'string', 'settings' => ['max_length' => 255]],
      'census_section_layout' => ['type' => 'list_string', 'settings' => ['allowed_values' => census_allowed_values_section_layout()]],
      'census_section_intro' => ['type' => 'text_long'],
      'census_section_media' => ['type' => 'entity_reference', 'settings' => ['target_type' => 'media']],
      'census_section_groups' => ['type' => 'entity_reference_revisions', 'cardinality' => -1, 'settings' => ['target_type' => 'paragraph']],
      'census_section_items' => ['type' => 'entity_reference_revisions', 'cardinality' => -1, 'settings' => ['target_type' => 'paragraph']],
      'census_section_publications' => ['type' => 'entity_reference', 'cardinality' => -1, 'settings' => ['target_type' => 'node']],
      'census_section_expanded' => ['type' => 'boolean'],
      'census_group_title' => ['type' => 'string', 'settings' => ['max_length' => 255]],
      'census_group_description' => ['type' => 'text_long'],
      'census_group_items' => ['type' => 'entity_reference_revisions', 'cardinality' => -1, 'settings' => ['target_type' => 'paragraph']],
      'census_item_title' => ['type' => 'string', 'settings' => ['max_length' => 255]],
      'census_item_key' => ['type' => 'string', 'settings' => ['max_length' => 255]],
      'census_item_description' => ['type' => 'text_long'],
      'census_item_release_date' => ['type' => 'string', 'settings' => ['max_length' => 255]],
      'census_item_summary' => ['type' => 'string_long'],
      'census_item_actions' => ['type' => 'entity_reference_revisions', 'cardinality' => -1, 'settings' => ['target_type' => 'paragraph']],
      'census_item_publication' => ['type' => 'entity_reference', 'settings' => ['target_type' => 'node']],
      'census_item_groups' => ['type' => 'entity_reference_revisions', 'cardinality' => -1, 'settings' => ['target_type' => 'paragraph']],
      'census_action_label' => ['type' => 'string', 'settings' => ['max_length' => 255]],
      'census_action_type' => ['type' => 'list_string', 'settings' => ['allowed_values' => census_allowed_values_action_type()]],
      'census_action_link' => ['type' => 'link'],
