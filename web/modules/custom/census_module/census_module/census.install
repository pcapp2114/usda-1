/**
 * Configures simple view displays.
 */
function census_configure_view_displays(): void {
  foreach (['census', 'census_publication'] as $bundle) {
    $display = EntityViewDisplay::load("node.{$bundle}.default") ?: EntityViewDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => $bundle,
      'mode' => 'default',
      'status' => TRUE,
      'id' => "node.{$bundle}.default",
    ]);

    $display->setComponent('census_description', ['type' => 'text_default', 'label' => 'hidden', 'weight' => 0]);
    $display->setComponent('census_sections', ['type' => 'entity_reference_revisions_entity_view', 'label' => 'hidden', 'weight' => 10, 'settings' => ['view_mode' => 'default', 'link' => '']]);
    $display->save();
  }

  foreach (['census_section', 'census_group', 'census_item', 'census_action'] as $bundle) {
    $display = EntityViewDisplay::load("paragraph.{$bundle}.default") ?: EntityViewDisplay::create([
      'targetEntityType' => 'paragraph',
      'bundle' => $bundle,
      'mode' => 'default',
      'status' => TRUE,
      'id' => "paragraph.{$bundle}.default",
    ]);
    $display->save();
  }
}

/**
 * Creates or updates a field storage definition.
 */
function census_ensure_field_storage(string $entity_type, string $field_name, array $definition): void {
  $existing = FieldStorageConfig::loadByName($entity_type, $field_name);
  if ($existing) {
    return;
  }

  $values = [
    'entity_type' => $entity_type,
    'field_name' => $field_name,
    'type' => $definition['type'],
    'cardinality' => $definition['cardinality'] ?? 1,
    'settings' => $definition['settings'] ?? [],
    'translatable' => FALSE,
  ];

  FieldStorageConfig::create($values)->save();
}

/**
 * Creates or updates a field attachment for a bundle.
 */
function census_ensure_field(string $entity_type, string $bundle, string $field_name, array $definition): void {
  $existing = FieldConfig::loadByName($entity_type, $bundle, $field_name);
  if ($existing) {
    return;
  }

  $values = [
    'entity_type' => $entity_type,
    'bundle' => $bundle,
    'field_name' => $field_name,
    'label' => $definition['label'],
    'required' => $definition['required'] ?? FALSE,
    'settings' => $definition['settings'] ?? [],
    'translatable' => FALSE,
  ];

  FieldConfig::create($values)->save();
}

/**
 * Configures a node form display and its field groups.
 */
function census_configure_node_form_display(string $bundle, array $components, array $groups): void {
  $display = EntityFormDisplay::load("node.{$bundle}.default") ?: EntityFormDisplay::create([
    'targetEntityType' => 'node',
    'bundle' => $bundle,
    'mode' => 'default',
    'status' => TRUE,
    'id' => "node.{$bundle}.default",
  ]);

  foreach ($components as $field_name => $component) {
    $display->setComponent($field_name, [
      'type' => $component['type'],
      'weight' => $component['weight'] ?? 0,
      'settings' => $component['settings'] ?? [],
      'region' => 'content',
      'third_party_settings' => [],
    ]);
  }

  census_apply_field_groups($display, $groups);
  $display->save();
}

/**
 * Configures a paragraph form display and its field groups.
 */
function census_configure_paragraph_form_display(string $bundle, array $components, array $groups): void {
  $display = EntityFormDisplay::load("paragraph.{$bundle}.default") ?: EntityFormDisplay::create([
    'targetEntityType' => 'paragraph',
    'bundle' => $bundle,
    'mode' => 'default',
    'status' => TRUE,
    'id' => "paragraph.{$bundle}.default",
  ]);

  foreach ($components as $field_name => $component) {
    $display->setComponent($field_name, [
      'type' => $component['type'],
      'weight' => $component['weight'] ?? 0,
      'settings' => $component['settings'] ?? [],
      'region' => 'content',
      'third_party_settings' => [],
    ]);
  }

  census_apply_field_groups($display, $groups);
  $display->save();
}

/**
 * Applies Field Group third party settings to a form display.
 */
function census_apply_field_groups(EntityFormDisplay $display, array $groups): void {
  foreach ($groups as $group_name => $group) {
    $format_type = $group['format_type'];
    $format_settings = [];

    if ($format_type === 'tabs') {
      $format_settings = [
        'direction' => 'horizontal',
        'width_breakpoint' => 640,
      ];
    }
    elseif ($format_type === 'tab') {
      $format_settings = [
        'formatter' => 'open',
        'description' => '',
        'required_fields' => TRUE,
        'id' => '',
        'classes' => '',
      ];
    }
    elseif ($format_type === 'details') {
      $format_settings = [
        'open' => TRUE,
        'description' => '',
        'required_fields' => TRUE,
        'id' => '',
        'classes' => '',
      ];
    }

    $display->setThirdPartySetting('field_group', $group_name, [
      'children' => $group['children'],
      'label' => $group['label'],
      'region' => 'content',
      'parent_name' => $group['parent_name'] ?? '',
      'weight' => $group['weight'] ?? 0,
      'format_type' => $format_type,
      'format_settings' => $format_settings,
    ]);
  }
}

/**
 * Paragraph handler settings helper.
 */
function census_paragraph_handler_settings(array $bundles): array {
  $targets = [];
  foreach ($bundles as $bundle) {
    $targets[$bundle] = $bundle;
  }
  return [
    'handler' => 'default:paragraph',
    'handler_settings' => [
      'target_bundles' => $targets,
      'negate' => 0,
    ],
  ];
}

/**
 * Node reference settings helper.
 */
function census_node_ref_settings(array $bundles): array {
  $targets = [];
  foreach ($bundles as $bundle) {
    $targets[$bundle] = $bundle;
  }
  return [
    'handler' => 'default:node',
    'handler_settings' => [
      'target_bundles' => $targets,
      'sort' => ['field' => '_none'],
      'auto_create' => FALSE,
    ],
  ];
}

/**
 * Media reference settings helper.
 */
function census_media_ref_settings(): array {
  return [
    'handler' => 'default:media',
    'handler_settings' => [
      'target_bundles' => NULL,
      'sort' => ['field' => '_none'],
      'auto_create' => FALSE,
    ],
  ];
}

