{#
/**
 * @file
 * Default theme implementation for a cell of a Calendar View table.
 *
 * Available variables:
 * - elements: Original variables passed to this template.
 * - attributes: HTML attributes for the wrapper.
 * - timestamp: The datetime value.
 * - empty: Wether or not this day as content.
 * - content: Custom content.
 * - rows: A list of view rows including the following:
 *   - content: The content as a render array.
 *   - attributes: The date field name used to get this content.
 *
 * @see template_preprocess_calendar_view_day()
 *
 * @ingroup themeable
 */
#}
{%
  set classes = [
    'calendar-view-day',
    empty ? 'empty',
  ]
%}

<div{{ attributes.addClass(classes) }}>
  {% set html_date = timestamp|format_date('html_date') %}
  {% set count = not rows ? 0 : rows|length %}
  {% set day_title %}
    {% trans %}
      {{ count }} result for {{ html_date }}
    {% plural count %}
      {{ count }} results for {{ html_date }}
    {% endtrans %}
  {% endset %}

	{# The day #}
	{% block day_number %}
    <time class="calendar-view-day__number" datetime="{{ timestamp|date('Y-m-d\TH:i:s') }}" title="{{ day_title|trim }}">
      {{ timestamp|date('j') }}
    </time>
	{% endblock %}

  {% block day_content %}
    {% if empty %}
      {# Empty #}
      <div class="calendar-view-day__rows empty"></div>
    {% else %}
      {# Events #}
      <ul class="calendar-view-day__rows">

        {% set newArray = [] %}
        {% for row in rows %}
          {% set row_classes = [default_row_class ? 'views-row'] %}
          {% set date = row.content['#row']._entity.field_release_date_time.value %}
          {% if date not in newArray %}
            {% set newArray = newArray|merge([date]) %}
          {% endif %}
        {% endfor %}

        {% for result in newArray %}
          {% set break = false %}
          {% for row in rows %}
            {% set date = row.content['#row']._entity.field_release_date_time.value %}
            {% set title = row.content['#row']._entity.title.value %}
            {% if row|length > 1 and break == false and result == date and title != 'HOLIDAY' %}
              <strong>{{result|date('g:i A')}} ET</strong>
              {% set break = true %}
            {% endif %}
          {% endfor %}

          {# <li{{ row.attributes.addClass(row_classes,'calendar-view-day__row') }}> #}
          <ul>
            {% for row in rows %}
              {% set date = row.content['#row']._entity.field_release_date_time.value %}
              {% set today = "now"|date("m/d/Y") %}
              {% set title = row.content['#row']._entity.title.value %}
              {% set quickStat = row.content['#row']._entity.field_quick_stats_release.value %}
              {% set url = row.content['#row']._entity.field_release_url.uri %}
              {% if title != 'HOLIDAY' %}
                {% if date == result and quickStat == 'N' %}
                  {% if date|date("m/d/Y") == today %}
                    <li><a href="/data-and-statistics/todays-releases" target="_blank">{{title}}</a></li>
                  {% else %}
                    <li><a href="{{url}}" target="_blank">{{title}}</a></li>
                  {% endif %}
                {% endif %}
              {% else %}
                {{title}}
              {% endif %}
            {% endfor %}
          </ul>
        {% endfor %}

        {% for result in newArray %}
          {% set break = false %}
          {% for row in rows %}
            {% set quickStat = row.content['#row']._entity.field_quick_stats_release.value %}
            {% set date = row.content['#row']._entity.field_release_date_time.value %}
            {% if quickStat == 'Y' %}
              {% if row|length > 1 and break == false and result == date %}
                <strong>{{result|date('g:i A')}} ET - Quick Stats Database</strong>
                {% set break = true %}
              {% endif %}
            {% endif %}
          {% endfor %}
          <ul>
            {% for row in rows %}
              {% set date = row.content['#row']._entity.field_release_date_time.value %}
              {% set today = "now"|date("m/d/Y") %}
              {% set title = row.content['#row']._entity.title.value %}
              {% set quickStat = row.content['#row']._entity.field_quick_stats_release.value %}
              {% set url = row.content['#row']._entity.field_release_url.uri %}
              {% if date == result and quickStat == 'Y' %}
                {# <li{{ row.attributes.addClass(row_classes,'calendar-view-day__row') }}> #}
                {% if date|date("m/d/Y") == today %}
                  <li><a href="/data-and-statistics/todays-releases" target="_blank">{{title}}</a></li>
                {% else %}
                  <li><a href="{{url}}" target="_blank">{{title}}</a></li>
                {% endif %}
              {% endif %}
            {% endfor %}
          </ul>
        {% endfor %}

      </ul>
    {% endif %}
  {% endblock %}
</div>
