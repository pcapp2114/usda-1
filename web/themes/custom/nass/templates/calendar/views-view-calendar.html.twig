{#
/**
 * @file
 * Default theme implementation to display a view in a Calendar style.
 *
 * Default available variables :
 * - title: The title of this group of rows. May be empty.
 * - calendar: The calendar created in template preprocess.
 * - rows: A list of the view's row items.
 *   - attributes: The row's HTML attributes.
 *   - content: The row's content.
 * - view: The view object.
 * - default_row_class: tells if default classes should be used on rows.
 * - options: custom variables from Calendar style settings.
 *   - filters: The date fields selected for this Calendar.
 *   - weekday_start: The day to start a calendar row.
 *   - display_rows: Wether or not to display default View results.
 *
 * @see template_preprocess_views_view_calendar()
 *
 * @ingroup themeable
 */
#}
{% block libraries %}
  {{ attach_library ('calendar_view/calendar') }}
  {{ attach_library ('calendar_view/multiday') }}
{% endblock %}

<style type="text/css">
  @media print {
    body {
      zoom: 80%;
    }
    table {
      zoom: 55%; 
    }
    .region-hero {
      display: none;
    }
    #header {
      display: none;
    }
    .region-sidebar-second {
      display: none;
    }
    .button-wrap {
      display: none !important;
    }
    .calendar-view-table tbody {
      grid-template-columns: 5;
    }
    .calendar-view-table.list-view thead {
      display: none;
    }
    .calendar-view-table tr {
      grid-column: inherit;
      width: 100%;
    }   
    .calendar-view-table, .calendar-view-table tr, .calendar-view-table thead, .calendar-view-table tbody {
      grid-template-columns: 1fr 1fr 1fr 1fr 1fr !important;
    }    
    .calendar-view-table thead {
      display: grid;
    }  
    .calendar-view-table thead th {
      background-color: #fff;
      color: #000;
      border-color: #000;
    }  
    .calendar-view-table tbody td {
      color: #000;
      border-color: #000;
    }    
    td.previous-month{
      display: grid !important;
    }
    .calendar-view-table .next-month, .calendar-view-table .previous-month {
      display: grid !important;
      background-color: #ddd;
    }    
    .calendar-view-table .calendar-view-day__number {
      align-self: end !important;
    }    
    footer.site-footer {
      display: none;
    } 
    .region-content {
      width: 100%;
    }
    .release-calendar h2 {
      font-size: 1.5rem;
      margin-bottom: 0;
      text-align: center;
    }    
  }
</style>

{% block calendars %}
  <div class="view-calendar">
    {{ calendars }}
  </div>
{% endblock %}

{% block rows %}
  {% if options.display_rows %}
    <div class="view-results">
      {% for row in rows %}
        {% set row_classes = [ default_row_class ? 'views-row'] %}
        <div{{ row.attributes.addClass(row_classes) }}>
          {{- row.content -}}
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}
