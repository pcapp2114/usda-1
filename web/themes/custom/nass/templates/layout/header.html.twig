<div id="page-wrapper">
  <div id="page">
    <header id="header" class="header" role="banner">
      <div class="section layout-container clearfix">
        <div class="header-top" id="gov-banner">
          {% include directory ~ '/templates/blocks/block--official.govwebsite.html.twig' %}
        </div>
        <div class="header">
          <div class="grid-container">
            <div class="grid-row">
              <div class="grid-col-5">
                {% include directory ~ '/templates/blocks/block--system-branding-block.html.twig' %}
              </div>
              <div class="grid-col-7">
                <div class="search">
                  <a href="/search/content" aria-label="Search" title="Search">
                    <img src="{{ base_path ~ directory }}/assets/img/usa-icons-bg/search--black.svg">
                  </a>
                </div>
                <a href="https://portal.agcounts.usda.gov/portal/s/" target="_blank">
                  <button type="" class="usa-button">
                    Complete Survey Online
                  </button>
                </a>  
              </div>
            </div>
          </div>
        </div>
        <div id="nass-nav">
          {{ page.primary_menu }}
        </div>
        <div id="nass-alert">
          {{ page.alert }}
        </div>
      </div>
    </header>