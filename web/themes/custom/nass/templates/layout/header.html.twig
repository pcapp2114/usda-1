<div id="page-wrapper">
  <div id="page">
    <header id="header" class="header" role="banner">
      <div class="section layout-container clearfix">
        <div class="header-top" id="gov-banner">
          {% include directory ~ '/templates/blocks/block--official.govwebsite.html.twig' %}
        </div>
        <div class="header">
          <div class="grid-container">
            <div class="grid-row">
              <div class="grid-col-5">
                {% include directory ~ '/templates/blocks/block--system-branding-block.html.twig' %}
              </div>
              <div class="grid-col-7">
                <div class="search">
                  <form id="search_form" action=https://search.usa.gov/search accept-charset="UTF-8" method="get">
                    <input type="hidden" name="affiliate" id="affiliate" value="usda-nass" autocomplete="off" />
                    <label for="query">Enter Search Term(s):</label>
                    <input type="text" name="query" id="query" autocomplete="off" class="usagov-search-autocomplete" />
                    <input type="submit" name="commit" value="Search" data-disable-with="Search" />
                  </form>
                </div>
                <a href="https://portal.agcounts.usda.gov/portal/s/" target="_blank">
                  <button type="" class="usa-button">
                    Complete Survey Online
                  </button>
                </a>
              </div>
            </div>
          </div>
        </div>
        <div id="nass-nav">
          {{ page.primary_menu }}
        </div>
        <div id="nass-alert">
          {{ page.alert }}
        </div>
      </div>
    </header>
