<div id="page-wrapper">
  <div id="page">
    <header id="header" class="header" role="banner">
      <div class="section layout-container clearfix">
        <div class="header-top" id="gov-banner">
          {% include directory ~ '/templates/blocks/block--official.govwebsite.html.twig' %}
        </div>
        <div class="header">
          <div class="grid-container">
            <div class="grid-row">
              <div class="grid-col-6">
                {% include directory ~ '/templates/blocks/block--system-branding-block.html.twig' %}
              </div>
              <div class="grid-col-6">
                <div class="search">
                 <form id="search_form" class="usa-search usa-search--small" role="search" action=https://search.usa.gov/search accept-charset="UTF-8" method="get">
                    <input type="hidden" name="affiliate" id="affiliate" value="usda-nass" autocomplete="off" />
                    <input type="search" name="query" id="query search-field-en-small" autocomplete="off" class="usa-input usagov-search-autocomplete" />
                   <button class="usa-button" type="submit" name="commit" value="Search" data-disable-with="Search">
                     <img src="{{ base_path ~ directory }}/assets/img/usa-icons-bg/search--white.svg" class="usa-search__submit-icon" alt="Search" />
                   </button>
                  </form>

                    <!-- <button class="usa-button" type="submit" name="commit" value="Search" data-disable-with="Search">
                      <img src="/themes/custom/nass/assets/img/usa-icons-bg/search--white.svg" class="usa-search__submit-icon" alt="Search" />
                    </button> -->


                </div>
                <a href="https://portal.agcounts.usda.gov/portal/s/" target="_blank">
                  <button type="" id="online-survey" class="usa-button">
                    Complete Survey Online
                  </button>
                </a>
              </div>
            </div>
          </div>
        </div>
        <div id="nass-nav">
          {{ page.primary_menu }}
        </div>
        <div id="nass-alert">
          {{ page.alert }}
        </div>
      </div>
    </header>
