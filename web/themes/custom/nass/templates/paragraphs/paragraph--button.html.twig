{% block paragraph %}
  {% block content %}

    {% set url = content.field_button_link.0['#url_title'] %}

    <button type="button" class="usa-button {{ content.field_button_color_paragraph|field_value }}">
      <a href="{{content.field_button_link.0['#url_title']}}" target="_blank">
        {{content.field_button_link.0['#title']}}
      </a>
    </button>

  {% endblock %}
{% endblock paragraph %}
