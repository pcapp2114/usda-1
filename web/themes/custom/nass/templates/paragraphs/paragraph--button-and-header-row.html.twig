{% block paragraph %}
  <div class="tablet:grid-col call-to-action-block-wrap">
    <div class="call-to-action-inner-wrap">
      {% block content %}    
        {% if paragraph.field_header_text.value %}
          <h2>{{ paragraph.field_header_text.0.value|raw }}</h2>
        {% endif %}
        {% if paragraph.field_optional_sub_text %} 
          <div class="sub-text">{{ paragraph.field_optional_sub_text.0.value }}</div>
        {% endif %}
        {% if paragraph.field_call_to_action_button %}
          <button type="" class="usa-button usa-button--outline usa-button--inverse">
            <a href="{{ paragraph.field_call_to_action_button.0.url }}">
              {{ paragraph.field_call_to_action_button.0.title }}
            </a>
          </button>
        {% endif %}
      {% endblock %}
    </div>
  </div>
{% endblock paragraph %}
