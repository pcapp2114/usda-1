{#
/**
 * @file
 * Theme override for a main view template.
 *
 * Available variables:
 * - attributes: Remaining HTML attributes for the element.
 * - css_name: A CSS-safe version of the view name.
 * - css_class: The user-specified classes names, if any.
 * - header: The optional header.
 * - footer: The optional footer.
 * - rows: The results of the view query, if any.
 * - empty: The content to display if there are no rows.
 * - pager: The optional pager next/prev links to display.
 * - exposed: Exposed widget form/info to display.
 * - feed_icons: Optional feed icons to display.
 * - more: An optional link to the next page of results.
 * - title: Title of the view, only used when displaying in the admin preview.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the view title.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the view title.
 * - attachment_before: An optional attachment view to be displayed before the
 *   view content.
 * - attachment_after: An optional attachment view to be displayed after the
 *   view content.
 * - dom_id: Unique id for every view being printed to give unique class for
 *   JavaScript.
 *
 * @see template_preprocess_views_view()
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}

{% set url = url('<current>')|render|render %}
{% set state = url|split('/') %}
{% set state = state[5]|capitalize|replace({"-":"%20"}) %}
<h2>{{ state }} - {{ view.getTitle() }} </h2>
{# {% set state = state|raw %} #}

<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if title %}
    {{ title }}
  {% endif %}
  {{ title_suffix }}
  {% if header %}
    <div class="view-header">
      {{ header }}
    </div>
  {% endif %}
  {% if exposed %}
    <div class="view-filters">
      {{ exposed }}
    </div>
  {% endif %}
  {% if attachment_before %}
    <div class="attachment attachment-before">
      {{ attachment_before }}
    </div>
  {% endif %}

  {% if rows %}
    <div class="view-content">
      <div class="table-row grid-row">
      {% for row in rows %}
        {% if 'All Tables' in row.content['#row']._entity.title.value|render|render %}
          <div class="tablet:grid-col-12">
            <div class="table-title all-tables">
            {% if '.pdf' in row.content['#row']._entity.field_table_pdf.entity.uri.value|file_url %}
              Volume 1, Complete Report, All Tables: 
              <a href="{{ row.content['#row']._entity.field_table_pdf.entity.uri.value|file_url }}" target="_blank">PDF</a>
            {% endif %}
            {% if '.txt' in row.content['#row']._entity.field_table_pdf.entity.uri.value|file_url %}
              <a href="{{ row.content['#row']._entity.field_table_pdf.entity.uri.value|file_url }}" target="_blank">TXT</a>
            {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
      {% for row in rows %}
        {% if 'Introduction' in row.content['#row']._entity.title.value|render|render %}
          <div class="tablet:grid-col-12">
            <div class="table-title"><a href="{{ row.content['#row']._entity.field_table_pdf.entity.uri.value|file_url }}" target="_blank">{{row.content['#row']._entity.title.value}}</a></div>
          </div>
        {% endif %}
      {% endfor %}
      {% for row in rows %}
        {% if 'Map and Figures' in row.content['#row']._entity.title.value|render|render %}
          <div class="tablet:grid-col-12">
            <div class="table-title"><a href="{{ row.content['#row']._entity.field_table_pdf.entity.uri.value|file_url }}" target="_blank">{{state}} Map and Figures</a></div>
          </div>
        {% endif %} 
      {% endfor %}
      </div>
    {% for row in rows %}
      {% if row.content['#row']._entity.field_table_number.value %}
        {% if row.content['#row']._entity.field_census_level.entity.name.value %}
          <div class="table-row grid-row">
        {% else %}
          <div class="table-row grid-row no-tag">
        {% endif %}
          <div class="tablet:grid-col-10">
              <div class="table-num">Table {{row.content['#row']._entity.field_table_number.value}}</div>
            {% if 'Appendix' in row.content['#row']._entity.title.value|render|render %}
              
            {% else %}
              <div class="table-title">{{row.content['#row']._entity.title.value}}</div>
            {% endif %}
            {% if row.content['#row']._entity.field_census_level.entity.name.value %}
              <div class="link-tag">{{row.content['#row']._entity.field_census_level.entity.name.value }}</div>
            {% endif %}
          </div>     
          <div class="tablet:grid-col-2">
            <ul class="usa-button-group usa-button-group--segmented">
              {% if row.content['#row']._entity.field_query_text.value %}
                <li class="usa-button-group__item">
                  <button type="button" class="usa-button usa-button--outline">
                    <a href="{{row.content['#row']._entity.field_query_text.value}}" target="_blank">Query</a>
                  </button>
                </li>
              {% endif %}
              {% if row.content['#row']._entity.field_table_pdf.entity.uri.value %}
                <li class="usa-button-group__item">
                  <button type="button" class="usa-button usa-button--outline">
                    <a href="{{ row.content['#row']._entity.field_table_pdf.entity.uri.value|file_url }}" target="_blank">PDF</a>
                  </button>
                </li>
              {% endif %}
            </ul>
          </div>
        </div>
      {% endif %}
    {% endfor %}
      <div class="table-row grid-row">
      {% for row in rows %}
        {% if 'Appendix' in row.content['#row']._entity.title.value|render|render %}
          <div class="tablet:grid-col-12">
            <div class="table-title"><a href="{{ row.content['#row']._entity.field_table_pdf.entity.uri.value|file_url }}" target="_blank">{{row.content['#row']._entity.title.value}}</a></div>
          </div>
        {% endif %} 
        {% if row.content['#row']._entity.title.value|render|render == 'Index' %}
          <div class="tablet:grid-col-12">
            <div class="table-title"><a href="{{ row.content['#row']._entity.field_table_pdf.entity.uri.value|file_url }}" target="_blank">{{row.content['#row']._entity.title.value}}</a></div>
          </div>
        {% endif %} 
      {% endfor %}
      </div> 
    </div>
  {% elseif empty %}
    <div class="view-empty">
      {{ empty }}
    </div>
  {% endif %}

  {% if pager %}
    {{ pager }}
  {% endif %}
  {% if attachment_after %}
    <div class="attachment attachment-after">
      {{ attachment_after }}
    </div>
  {% endif %}
  {% if more %}
    {{ more }}
  {% endif %}
  {% if footer %}
    <div class="view-footer">
      {{ footer }}
    </div>
  {% endif %}
  {% if feed_icons %}
    <div class="feed-icons">
      {{ feed_icons }}
    </div>
  {% endif %}
</div>
