# Set the environment port number. It can be between 1 and 65536.
# This will follow localhost and will be where your site will be located.
# Use "$lsof | grep localhost" to make sure the port you want to use is available.
# Example: 8021
ENV_PORT=8044

DB_NAME=drupal
DB_USERNAME=drupal
DB_PASSWORD=drupal123
DB_ROOT_PASSWORD=drupal