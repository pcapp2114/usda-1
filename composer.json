{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal 9 projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "chi-teck/drupal-code-generator": "^2.4",
        "composer/installers": "^1.9",
        "consolidation/robo": "^3",
        "cweagans/composer-patches": "^1.7",
        "drupal/address": "^1.10",
        "drupal/admin_toolbar": "^3.5",
        "drupal/adminimal_theme": "^1.7",
        "drupal/bef_select": "^2.0",
        "drupal/better_exposed_filters": "^6.0",
        "drupal/block_field": "^1.0@RC",
        "drupal/calendar_view": "2.1.x-dev@dev",
        "drupal/color_field": "^3.0",
        "drupal/condition_path": "^2.0",
        "drupal/content_access": "^2.0",
        "drupal/content_export_csv": "^4.7",
        "drupal/core-composer-scaffold": "9.5.11",
        "drupal/core-project-message": "9.5.11",
        "drupal/core-recommended": "9.5.11",
        "drupal/cshs": "^4.0",
        "drupal/ctools": "^4.0",
        "drupal/devel": "^5.0",
        "drupal/dropzonejs": "^2.11",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/entity_browser": "^2.6",
        "drupal/entity_reference_revisions": "^1.12",
        "drupal/entityqueue": "^1.9",
        "drupal/environment_indicator": "^4.0",
        "drupal/extlink": "^1.7",
        "drupal/feeds": "^3.0@beta",
        "drupal/feeds_tamper": "2.x-dev@dev",
        "drupal/field_group": "^3.6",
        "drupal/field_permissions": "^1.2",
        "drupal/field_permissions_group": "^1.0",
        "drupal/flag": "^4.0@beta",
        "drupal/fpa": "^4.0",
        "drupal/fullcalendar_view": "^5.1",
        "drupal/gcontent_moderation": "^1.0@beta",
        "drupal/group": "^1.4",
        "drupal/hierarchy_manager": "^3.4",
        "drupal/honeypot": "^2.1",
        "drupal/imce": "^3.1",
        "drupal/inline_entity_form": "^1.0@RC",
        "drupal/jquery_ui": "^1.7",
        "drupal/jquery_ui_accordion": "^2.1",
        "drupal/jquery_ui_datepicker": "^2.1",
        "drupal/jquery_ui_slider": "^2.1",
        "drupal/jquery_ui_touch_punch": "^1.1",
        "drupal/link_attributes": "^2.1",
        "drupal/media_bulk_upload": "^3.0",
        "drupal/menu_export": "^1.3",
        "drupal/migrate_plus": "^6.0",
        "drupal/oauth_login_oauth2": "^3.0",
        "drupal/paragraphs": "^1.15",
        "drupal/pathauto": "^1.13",
        "drupal/php": "^1.2",
        "drupal/redirect": "^1.10",
        "drupal/scheduler": "^2.2",
        "drupal/search_api": "^1.23",
        "drupal/search_api_solr": "^4.2",
        "drupal/select2": "^1.13",
        "drupal/selective_better_exposed_filters": "3.0.x-dev@dev",
        "drupal/structure_sync": "^2.0",
        "drupal/superfish": "^1.8",
        "drupal/sync_uuids": "^1.1",
        "drupal/tamper": "^1.0@alpha",
        "drupal/taxonomy_import": "^2.0",
        "drupal/taxonomy_manager": "^2.0",
        "drupal/tb_megamenu": "^3.0@alpha",
        "drupal/token": "^1.15",
        "drupal/twig_field_value": "^2.0",
        "drupal/twig_tweak": "^3.3",
        "drupal/typed_data": "^2.0",
        "drupal/ultimate_cron": "^2.0@beta",
        "drupal/upgrade_status": "^4.3",
        "drupal/uswds": "^3.1",
        "drupal/uswds_paragraphs": "^2.0@beta",
        "drupal/variationcache": "^1.5",
        "drupal/video_embed_field": "^2.4",
        "drupal/views_accordion": "^2.0",
        "drupal/views_block_area": "^1.0@beta",
        "drupal/views_field_select_filter": "^1.0",
        "drupal/views_jump_menu": "^1.0",
        "drupal/views_taxonomy_term_name_depth": "^7.0",
        "drupal/views_year_filter": "^2.1",
        "drupal/webform": "^6.2",
        "drupal/webform_shs": "^2.0@beta",
        "drush/drush": "^11",
        "enyo/dropzone": "^5.7",
        "querypath/querypath": "^3.0",
        "symfony/filesystem": "^5",
        "wikimedia/composer-merge-plugin": "^2.0"
    },
    "conflict": {
        "drupal/drupal": "*",
        "drupal/ctools": "^3.10 || ^4.0.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform-check": false,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "wikimedia/composer-merge-plugin": true,
            "robloach/component-installer": true
        }
    },
    "extra": {
        "enable-patching": true,
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "merge-plugin": {
            "include": [
                "web/modules/contrib/dropzonejs/composer.libraries.json"
            ]
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "patches": {
            "drupal/feeds_ex": {
              "Keep html tags of inner element": "https://git.drupalcode.org/project/feeds_ex/-/merge_requests/3.diff"
            },
            "drupal/rules": {
              "No Listeners Rules": "https://www.drupal.org/files/issues/2022-01-27/rules_registers_no_l-2816033-98.patch"
            },
            "drupal/paragraphs": {
              "Fix for feeds import and paragraphs": "https://www.drupal.org/files/issues/2018-11-14/3001016-feeds-integration-fix-7.patch"
            },
            "drupal/path_redirect_import": {
              "Fix for migrate_tools": "https://www.drupal.org/files/issues/2023-07-06/path_redirect_import-3373025.patch"
            },
            "drupal/cshs": {
              "Fix for hierarchy selection": "https://www.drupal.org/files/issues/2023-03-22/3270062-problem-filtering-first-9.patch"
            }
        }
    }
}
