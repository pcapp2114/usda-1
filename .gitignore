# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
vendor/
web/modules/contrib

#dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/

#dist/

# JetBrains IDE
.idea/

# VSCode
.vscode

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Ignore settings.php
/web/sites/default/settings.php

# Ignore file uploads
/private_files
/web/sites/default/files
/web/sites/default/backup-files


# Ignore .git directories
.git

# Ignore Local Directory
/local
/local/*

# Ignore databases, files, and backups
!backups/.gitkeep
backups/files/*
!backups/files/.gitkeep
backups/databases/*
!backups/databases/.gitkeep
*.sql
*.sql.gz
*.gz
*.tar.gz

# Makefile temp dir
.tmp/**

# .env files typically contain sensitive information and should not be checked into source control
# If you need the latest .env file, contact a member of the team
*.env

# Composer's lock file can stay local
#composer.lock

upload2azure.sh
